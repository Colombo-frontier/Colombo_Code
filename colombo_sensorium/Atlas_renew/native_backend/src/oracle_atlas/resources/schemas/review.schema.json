{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review",
  "type": "object",
  "properties": {
    "subject_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "review_type": {
      "type": "string",
      "enum": [
        "extraction",
        "identity",
        "profile"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "revise",
        "defer"
      ]
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject_id": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "approve",
              "revise",
              "defer"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "subject_id",
          "verdict",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "extraction_omission",
              "source_ambiguity",
              "proof_gap",
              "applicability",
              "identity_ambiguity",
              "coverage",
              "protocol_error",
              "other"
            ]
          },
          "scope": {
            "type": "string"
          },
          "subject_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "extraction",
                "identity",
                "bound",
                "profile",
                "publication"
              ]
            }
          },
          "message": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "resolves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "issue_id",
          "kind",
          "scope",
          "subject_refs",
          "blocks",
          "message",
          "evidence_refs",
          "resolves"
        ],
        "additionalProperties": false
      }
    },
    "approved_bound_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "coverage_audit": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check_id": {
                "type": "string",
                "enum": [
                  "zero_query",
                  "exact_reconstruction",
                  "coarse_accuracy",
                  "dimension_endpoints",
                  "confidence_endpoints",
                  "degenerate_instances",
                  "envelopes_and_monotonicity",
                  "moment_contracts",
                  "supported_transfers"
                ]
              },
              "scope": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "not_applicable",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string"
              },
              "result_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "proof_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            },
            "required": [
              "check_id",
              "scope",
              "status",
              "reason",
              "result_refs",
              "proof_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 9,
          "description": "Check nine boundary categories per view/regime. Give specific reasons for inapplicability; the template is not a proof of mathematical exhaustiveness."
        },
        "resolved_issue_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "carried_issue_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "new_blocker_justifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue_id": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "enum": [
                  "correctness",
                  "evidence",
                  "contract",
                  "coverage"
                ]
              },
              "why_new": {
                "type": "string"
              },
              "affected_subjects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "issue_id",
              "category",
              "why_new",
              "affected_subjects"
            ],
            "additionalProperties": false
          }
        },
        "followups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "reason_nonblocking": {
                "type": "string"
              }
            },
            "required": [
              "scope",
              "description",
              "reason_nonblocking"
            ],
            "additionalProperties": false
          }
        },
        "reuse_context_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reused_bound_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "scope",
        "checks",
        "resolved_issue_ids",
        "carried_issue_ids",
        "new_blocker_justifications",
        "followups",
        "reuse_context_ref",
        "reused_bound_ids"
      ],
      "additionalProperties": false,
      "description": "A new profile review checks coverage item by item and consolidates mandatory obligations. A second review explicitly carries forward/resolves old issues; new coverage blockers explain new evidence or first-review omissions. New counterexamples or invalid dependencies may always block. Reuse is limited to per-bound candidates whose unchanged dependencies the controller has verified; the current proposal still requires approval."
    },
    "proof_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proof_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "scope": {
            "type": "string",
            "enum": [
              "standalone_proposition"
            ]
          },
          "assumptions_complete": {
            "const": true
          },
          "context_pointers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "proof_ref",
          "scope",
          "assumptions_complete",
          "context_pointers",
          "reason"
        ],
        "additionalProperties": false
      },
      "description": "Explicit credentials from an independent profile review for fixed proof propositions, introduced in 1.0.3. Actually verify each proposition, its complete assumptions, original content, and dependencies. context_pointers includes /common_specification and every necessary profile definition; the controller recomputes hashes from fixed prepared content. Do not infer proof approval from approved_bound_ids. An empty array is allowed when certification is unsupported, but reuse must not then be claimed."
    },
    "proof_issue_scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "affected_proof_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "uniqueItems": true
          },
          "scope_complete": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "issue_id",
          "affected_proof_refs",
          "scope_complete",
          "reason"
        ],
        "additionalProperties": false
      },
      "description": "Cover every scientific issue in profile/research/review that blocks bound/profile/publication and specify its impact on standalone proof propositions. Unknown/omitted scope requires full review. An empty affected list is allowed only after verifying that the issue is unrelated to the proof. An unresolved blocker directly targeting that proof cannot be overridden as unaffected."
    },
    "proof_reuse_context_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "When reusing proofs, bind the current input proof_context_ref; an old review or producer-reported catalog cannot replace it."
    },
    "reused_proof_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "uniqueItems": true,
      "description": "List only candidates verified by the controller in this run and explicitly approved by current proof_approvals. Reuse concerns standalone propositions only; current bound applicability, coverage/envelopes/reader/five files, and every active bound still require new review."
    }
  },
  "required": [
    "subject_ref",
    "review_type",
    "verdict",
    "assessments",
    "issues",
    "approved_bound_ids",
    "summary"
  ],
  "additionalProperties": false
}
