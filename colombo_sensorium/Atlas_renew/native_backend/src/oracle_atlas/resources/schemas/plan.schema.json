{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "plan",
  "type": "object",
  "properties": {
    "task_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "years": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1900
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "query_budget": {
      "type": "integer",
      "minimum": 1
    },
    "paper_limit": {
      "type": "integer",
      "minimum": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "task_ids",
    "years",
    "sources",
    "query_budget",
    "paper_limit",
    "notes"
  ],
  "additionalProperties": false
}
