{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proof",
  "type": "object",
  "properties": {
    "proof_id": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "enum": [
        "analyst_transfer",
        "analyst_derivation"
      ]
    },
    "proposition": {
      "type": "string"
    },
    "premises": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "argument": {
      "type": "string"
    },
    "boundary_cases": {
      "type": "string"
    },
    "quantifiers": {
      "type": "string"
    },
    "resource_accounting": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "extraction_omission",
              "source_ambiguity",
              "proof_gap",
              "applicability",
              "identity_ambiguity",
              "coverage",
              "protocol_error",
              "other"
            ]
          },
          "scope": {
            "type": "string"
          },
          "subject_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "extraction",
                "identity",
                "bound",
                "profile",
                "publication"
              ]
            }
          },
          "message": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "resolves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "issue_id",
          "kind",
          "scope",
          "subject_refs",
          "blocks",
          "message",
          "evidence_refs",
          "resolves"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "proof_id",
    "origin",
    "proposition",
    "premises",
    "argument",
    "boundary_cases",
    "quantifiers",
    "resource_accounting",
    "dependencies",
    "issues"
  ],
  "additionalProperties": false
}
