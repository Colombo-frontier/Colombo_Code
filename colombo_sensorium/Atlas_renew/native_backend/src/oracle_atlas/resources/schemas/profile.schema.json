{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "profile",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "setting_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "primary_domain": {
      "type": "string"
    },
    "common_specification": {
      "type": "object"
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "quantities": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "resource_projections": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "regimes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "bounds": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "comparison_id": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "comparison_key": {
            "type": "object",
            "properties": {
              "setting_id": {
                "type": "string"
              },
              "view_id": {
                "type": "string"
              },
              "guarantee_id": {
                "type": "string"
              },
              "quantity_id": {
                "type": "string"
              },
              "resource_projection_id": {
                "type": "string"
              },
              "regime_id": {
                "type": "string"
              }
            },
            "required": [
              "setting_id",
              "view_id",
              "guarantee_id",
              "quantity_id",
              "resource_projection_id",
              "regime_id"
            ],
            "additionalProperties": true
          },
          "setting_id": {
            "type": "string"
          },
          "view_id": {
            "type": "string"
          },
          "guarantee_id": {
            "type": "string"
          },
          "quantity_id": {
            "type": "string"
          },
          "resource_projection_id": {
            "type": "string"
          },
          "regime_id": {
            "type": "string"
          }
        },
        "required": [],
        "additionalProperties": true,
        "description": "A complexity comparison cell. Requires the full six-part comparison_key (or equivalent legacy flat fields). Put textual relations to related settings/literature in relations; do not guess a missing view/guarantee/regime.",
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "comparison_id"
                ]
              },
              {
                "required": [
                  "id"
                ]
              }
            ]
          },
          {
            "anyOf": [
              {
                "required": [
                  "comparison_key"
                ]
              },
              {
                "required": [
                  "setting_id",
                  "view_id",
                  "guarantee_id",
                  "quantity_id",
                  "resource_projection_id",
                  "regime_id"
                ]
              }
            ]
          }
        ]
      }
    },
    "bracket_rows": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "proofs": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "facets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "summary_status": {
      "type": "object"
    },
    "provenance": {
      "type": "object"
    },
    "tag_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "type": "string"
          },
          "axis": {
            "type": "string",
            "enum": [
              "TASK",
              "MODEL",
              "ORACLE",
              "ALGORITHMS",
              "OUTPUT",
              "METRIC",
              "GUARANTEE",
              "RESOURCE"
            ]
          },
          "value": {
            "type": "string"
          },
          "object_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "view_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reference a view_id declared in the current document, not a /views/N path. Preflight converts paths only when unambiguous; it must not guess identity mappings."
          },
          "operation_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reference an operation ID declared in the effective native interface of this view, not an /operations/N path. Record unknown permissions explicitly as unknown and null; do not invent operations."
          },
          "source_pointer": {
            "type": "string",
            "pattern": "^/",
            "description": "An existing RFC 6901 path inside the final profile. A view source binds the same view; an operation source binds the same native operation or an explicit statement.operation_ref. Do not carry over an old candidate layout directly."
          },
          "status": {
            "type": "string",
            "enum": [
              "known",
              "unknown",
              "not_applicable"
            ]
          }
        },
        "required": [
          "concept_id",
          "axis",
          "value",
          "object_ref",
          "view_ref",
          "operation_ref",
          "source_pointer",
          "status"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "schema_version",
    "setting_id",
    "title",
    "primary_domain",
    "common_specification",
    "views",
    "parameters",
    "symbols",
    "quantities",
    "resource_projections",
    "regimes",
    "bounds",
    "comparisons",
    "bracket_rows",
    "proofs",
    "evidence",
    "references",
    "facets",
    "relations",
    "aliases",
    "summary_status",
    "provenance"
  ],
  "additionalProperties": true
}
