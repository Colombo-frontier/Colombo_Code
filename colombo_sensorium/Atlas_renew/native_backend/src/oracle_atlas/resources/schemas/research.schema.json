{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research",
  "type": "object",
  "properties": {
    "candidate_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identity_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "action": {
      "type": "string",
      "enum": [
        "no_change",
        "update",
        "new"
      ]
    },
    "setting_id": {
      "type": "string"
    },
    "base_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "profile_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "result_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "proof_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "extraction_omission",
              "source_ambiguity",
              "proof_gap",
              "applicability",
              "identity_ambiguity",
              "coverage",
              "protocol_error",
              "other"
            ]
          },
          "scope": {
            "type": "string"
          },
          "subject_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "extraction",
                "identity",
                "bound",
                "profile",
                "publication"
              ]
            }
          },
          "message": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "resolves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "issue_id",
          "kind",
          "scope",
          "subject_refs",
          "blocks",
          "message",
          "evidence_refs",
          "resolves"
        ],
        "additionalProperties": false
      }
    },
    "change_summary": {
      "type": "string"
    },
    "tag_facts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "concept_id": {
            "type": "string"
          },
          "axis": {
            "type": "string",
            "enum": [
              "TASK",
              "MODEL",
              "ORACLE",
              "ALGORITHMS",
              "OUTPUT",
              "METRIC",
              "GUARANTEE",
              "RESOURCE"
            ]
          },
          "value": {
            "type": "string"
          },
          "object_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "view_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reference a view_id declared in the current document, not a /views/N path. Preflight converts paths only when unambiguous; it must not guess identity mappings."
          },
          "operation_ref": {
            "type": [
              "string",
              "null"
            ],
            "description": "Reference an operation ID declared in the effective native interface of this view, not an /operations/N path. Record unknown permissions explicitly as unknown and null; do not invent operations."
          },
          "source_pointer": {
            "type": "string",
            "pattern": "^/",
            "description": "An existing RFC 6901 path inside the final profile. A view source binds the same view; an operation source binds the same native operation or an explicit statement.operation_ref. Do not carry over an old candidate layout directly."
          },
          "status": {
            "type": "string",
            "enum": [
              "known",
              "unknown",
              "not_applicable"
            ]
          }
        },
        "required": [
          "concept_id",
          "axis",
          "value",
          "object_ref",
          "view_ref",
          "operation_ref",
          "source_pointer",
          "status"
        ],
        "additionalProperties": true
      }
    },
    "coverage_ledger": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check_id": {
                "type": "string",
                "enum": [
                  "zero_query",
                  "exact_reconstruction",
                  "coarse_accuracy",
                  "dimension_endpoints",
                  "confidence_endpoints",
                  "degenerate_instances",
                  "envelopes_and_monotonicity",
                  "moment_contracts",
                  "supported_transfers"
                ]
              },
              "scope": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "not_applicable",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string"
              },
              "result_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "proof_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            },
            "required": [
              "check_id",
              "scope",
              "status",
              "reason",
              "result_refs",
              "proof_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 9,
          "description": "Check nine boundary categories per view/regime. Give specific reasons for inapplicability; the template is not a proof of mathematical exhaustiveness."
        },
        "issue_resolutions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue_id": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "resolved",
                  "remaining",
                  "not_applicable"
                ]
              },
              "reason": {
                "type": "string"
              },
              "result_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "proof_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            },
            "required": [
              "issue_id",
              "status",
              "reason",
              "result_refs",
              "proof_refs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "scope",
        "checks",
        "issue_resolutions"
      ],
      "additionalProperties": false,
      "description": "Required for new tasks with coverage_scope_ref since 1.0.2; historical artifacts remain readable. Record verified and genuinely unresolved findings; do not present new algorithm ideas as approved results."
    }
  },
  "required": [
    "candidate_ref",
    "identity_ref",
    "action",
    "setting_id",
    "base_version",
    "profile_ref",
    "result_refs",
    "proof_refs",
    "issues",
    "change_summary"
  ],
  "additionalProperties": false
}
