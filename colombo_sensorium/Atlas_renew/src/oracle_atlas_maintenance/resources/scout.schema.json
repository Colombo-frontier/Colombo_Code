{
  "type": "object",
  "properties": {
    "setting_id": {
      "type": "string"
    },
    "base_version": {
      "type": "string"
    },
    "cutoff": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "no_change",
        "candidate_change",
        "incomplete"
      ]
    },
    "scope": {
      "type": "object",
      "properties": {
        "queries_complete": {
          "type": "boolean"
        },
        "examined_comparison_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_leads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "queries_complete",
        "examined_comparison_ids",
        "unresolved_leads",
        "note"
      ],
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_id": {
            "type": "string"
          },
          "impact": {
            "type": "string",
            "enum": [
              "improve_upper",
              "improve_lower",
              "fill_missing",
              "change_region",
              "invalidate",
              "status",
              "no_effect",
              "incomparable",
              "synthesis_only"
            ]
          },
          "comparison_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_hashes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "evidence_basis": {
            "type": "string",
            "enum": [
              "primary_source",
              "retained_baseline_derivation",
              "presentation_restructure"
            ]
          },
          "baseline_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "pointer": {
                  "type": "string"
                },
                "sha256": {
                  "type": "string"
                }
              },
              "required": [
                "pointer",
                "sha256"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "candidate_id",
          "impact",
          "comparison_ids",
          "source_hashes",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "patch": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collection": {
            "type": "string",
            "enum": [
              "bounds",
              "comparisons",
              "regimes",
              "evidence",
              "references",
              "proofs",
              "bracket_rows"
            ]
          },
          "id_field": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "before_hash": {
            "type": [
              "string",
              "null"
            ]
          },
          "value_json": {
            "type": "string"
          }
        },
        "required": [
          "collection",
          "id_field",
          "id",
          "before_hash",
          "value_json"
        ],
        "additionalProperties": false
      }
    },
    "summary_status_json": {
      "type": [
        "string",
        "null"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "joint_analysis_json": {
      "type": [
        "string",
        "null"
      ],
      "description": "A complete joint_analysis object encoded as JSON. Required for candidate_change. For no_change provide this body or an eligible exact joint_analysis_reuse reference, never both."
    },
    "joint_analysis_reuse": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "base_version": {"type": "string", "minLength": 1},
            "joint_analysis_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          },
          "required": ["base_version", "joint_analysis_hash"],
          "additionalProperties": false
        },
        {"type": "null"}
      ],
      "description": "Only no_change may echo the controller's qualified accepted_analysis_reuse identity after a complete own frozen baseline joint-analysis read. It grants no publication, source-read credit or approval for new claims."
    },
    "quantity_metadata_normalizations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quantity_id": {
            "type": "string"
          },
          "before_hash": {
            "type": "string"
          },
          "changes_json": {
            "type": "string"
          },
          "semantic_preservation_argument": {
            "type": "string"
          },
          "proof_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "quantity_id",
          "before_hash",
          "changes_json",
          "semantic_preservation_argument",
          "proof_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "setting_id",
    "base_version",
    "cutoff",
    "outcome",
    "scope",
    "findings",
    "patch",
    "summary_status_json",
    "rationale"
  ],
  "additionalProperties": false,
  "$comment": "New fields remain optional ONLY to read archived 0.1 handoffs. The live controller always requires joint synthesis; runtime makes every structured-output property required."
}
