{
  "type": "object",
  "properties": {
    "setting_id": {
      "type": "string"
    },
    "base_version": {
      "type": "string"
    },
    "prepared_hash": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "reject",
        "incomplete"
      ]
    },
    "approved_bound_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewed_comparison_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string"
    },
    "joint_analysis_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "joint_checks": {
      "type": "object",
      "properties": {
        "parameter_roles": {
          "type": "boolean"
        },
        "guarded_envelopes": {
          "type": "boolean"
        },
        "domain_accounting": {
          "type": "boolean"
        },
        "improvement_regions": {
          "type": "boolean"
        },
        "provenance": {
          "type": "boolean"
        },
        "display_consistency": {
          "type": "boolean"
        }
      },
      "required": [
        "parameter_roles",
        "guarded_envelopes",
        "domain_accounting",
        "improvement_regions",
        "provenance",
        "display_consistency"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "setting_id",
    "base_version",
    "prepared_hash",
    "verdict",
    "approved_bound_ids",
    "reviewed_comparison_ids",
    "issues",
    "rationale"
  ],
  "additionalProperties": false,
  "$comment": "Live 0.2 approvals require an exact joint_analysis_hash and all joint_checks. Historical 0.1 report parsing alone does not grant approval."
}
