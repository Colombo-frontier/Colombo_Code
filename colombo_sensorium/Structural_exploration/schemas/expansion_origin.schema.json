{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "expansion_origin",
  "type": "object",
  "properties": {
    "kind": {
      "const": "atlas_expansion"
    },
    "request_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "plan_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "opportunity_id": {
      "type": "string",
      "minLength": 1
    },
    "seed_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "designed_contract": {
      "const": true
    }
  },
  "required": [
    "kind",
    "request_ref",
    "plan_ref",
    "opportunity_id",
    "seed_refs",
    "designed_contract"
  ],
  "additionalProperties": true
}
