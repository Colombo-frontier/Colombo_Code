{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "expansion",
  "type": "object",
  "properties": {
    "request_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "plan_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "opportunity_id": {
      "type": "string",
      "minLength": 1
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "axis": {
            "type": "string",
            "enum": [
              "TASK",
              "MODEL",
              "ORACLE",
              "ALGORITHMS",
              "OUTPUT",
              "METRIC",
              "GUARANTEE",
              "RESOURCE"
            ]
          },
          "object_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "before": {
            "type": "string",
            "minLength": 1
          },
          "after": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "axis",
          "object_ref",
          "before",
          "after",
          "reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "well_posedness": {
      "type": "object",
      "properties": {
        "nonempty": {
          "type": "string",
          "enum": [
            "supported",
            "unresolved"
          ]
        },
        "objective_defined": {
          "type": "string",
          "enum": [
            "supported",
            "unresolved"
          ]
        },
        "oracle_implementable": {
          "type": "string",
          "enum": [
            "supported",
            "unresolved"
          ]
        },
        "not_trivial": {
          "type": "string",
          "enum": [
            "supported",
            "unresolved"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "nonempty",
        "objective_defined",
        "oracle_implementable",
        "not_trivial",
        "checks",
        "unknowns"
      ],
      "additionalProperties": false
    },
    "selection_reason": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "extraction_omission",
              "source_ambiguity",
              "proof_gap",
              "applicability",
              "identity_ambiguity",
              "coverage",
              "protocol_error",
              "other"
            ]
          },
          "scope": {
            "type": "string"
          },
          "subject_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "extraction",
                "identity",
                "bound",
                "profile",
                "publication",
                "expansion"
              ]
            }
          },
          "message": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "resolves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "issue_id",
          "kind",
          "scope",
          "subject_refs",
          "blocks",
          "message",
          "evidence_refs",
          "resolves"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "request_ref",
    "plan_ref",
    "opportunity_id",
    "candidate_ref",
    "changes",
    "well_posedness",
    "selection_reason",
    "issues"
  ],
  "additionalProperties": false
}
