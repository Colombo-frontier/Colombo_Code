{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "expansion_request",
  "type": "object",
  "properties": {
    "source_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "target_task_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "seed_setting_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_operators": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "oracle_substitution",
          "noise_protocol",
          "model_transfer",
          "layer_transfer",
          "target_change",
          "resource_change",
          "boundary_probe",
          "algorithm_permission"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "allowed_axes": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "TASK",
          "MODEL",
          "ORACLE",
          "ALGORITHMS",
          "OUTPUT",
          "METRIC",
          "GUARANTEE",
          "RESOURCE"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "fixed_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_description": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "balanced",
        "classical",
        "gaps"
      ]
    },
    "cutoff_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "max_seeds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "max_neighbors_per_seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "max_opportunities": {
      "type": "integer",
      "minimum": 1,
      "maximum": 80
    },
    "max_candidates": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "max_profiles": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "max_mutation_steps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "max_per_seed": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "max_per_operator": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "allow_existing_updates": {
      "type": "boolean"
    },
    "run_label": {
      "type": "string"
    }
  },
  "required": [
    "source_task_ids",
    "target_task_ids",
    "seed_setting_ids",
    "allowed_operators",
    "allowed_axes",
    "fixed_constraints",
    "scope_description",
    "priority",
    "cutoff_date",
    "max_seeds",
    "max_neighbors_per_seed",
    "max_opportunities",
    "max_candidates",
    "max_profiles",
    "max_mutation_steps",
    "max_per_seed",
    "max_per_operator",
    "allow_existing_updates",
    "run_label"
  ],
  "additionalProperties": false
}
