{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "task_proposal",
  "type": "object",
  "properties": {
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "formulation": {
            "type": "string"
          },
          "queries": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "label",
          "formulation",
          "queries",
          "evidence_refs",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "report_zh": {
      "type": "string"
    }
  },
  "required": [
    "proposals",
    "report_zh"
  ],
  "additionalProperties": false
}
