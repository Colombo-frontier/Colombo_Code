{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "checkpoint",
  "type": "object",
  "properties": {
    "summary": {
      "type": "string"
    },
    "refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "remaining": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "summary",
    "refs",
    "remaining"
  ],
  "additionalProperties": false
}
