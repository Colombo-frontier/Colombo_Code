{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "paper_batch",
  "type": "object",
  "properties": {
    "paper_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "coverage": {
      "type": "object"
    },
    "search_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    }
  },
  "required": [
    "paper_refs",
    "coverage",
    "search_refs"
  ],
  "additionalProperties": false
}
