{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "research_scope",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "minLength": 1
    },
    "queries_complete": {
      "type": "boolean"
    },
    "unresolved_leads": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "scope",
    "queries_complete",
    "unresolved_leads"
  ],
  "additionalProperties": false,
  "description": "Actual finite research scope. Completion and unresolved leads are declared explicitly; this does not certify exhaustive literature."
}
