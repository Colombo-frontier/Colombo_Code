{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "expansion_plan",
  "type": "object",
  "properties": {
    "request_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "neighborhood_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "opportunity_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "seed_setting_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "neighbor_setting_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "operators": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "oracle_substitution",
                "noise_protocol",
                "model_transfer",
                "layer_transfer",
                "target_change",
                "resource_change",
                "boundary_probe",
                "algorithm_permission"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "changed_axes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "TASK",
                "MODEL",
                "ORACLE",
                "ALGORITHMS",
                "OUTPUT",
                "METRIC",
                "GUARANTEE",
                "RESOURCE"
              ]
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "target_task_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "mutation_steps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "transformation": {
            "type": "string",
            "minLength": 1
          },
          "selection_reason": {
            "type": "string",
            "minLength": 1
          },
          "expected_value": {
            "type": "string",
            "minLength": 1
          },
          "transfer_leads": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "priority_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "opportunity_id",
          "title",
          "seed_setting_ids",
          "neighbor_setting_ids",
          "operators",
          "changed_axes",
          "target_task_ids",
          "mutation_steps",
          "transformation",
          "selection_reason",
          "expected_value",
          "transfer_leads",
          "risks",
          "priority_score"
        ],
        "additionalProperties": false
      }
    },
    "not_pursued": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "direction",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "coverage_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "request_ref",
    "neighborhood_ref",
    "opportunities",
    "not_pursued",
    "coverage_note"
  ],
  "additionalProperties": false
}
