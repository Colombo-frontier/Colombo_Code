{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "expansion_review",
  "type": "object",
  "properties": {
    "subject_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "revise",
        "defer",
        "exclude"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "scope_assessment": {
      "type": "string",
      "minLength": 1
    },
    "well_posedness_assessment": {
      "type": "string",
      "minLength": 1
    },
    "value_assessment": {
      "type": "string",
      "minLength": 1
    },
    "pending_comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "relation": {
            "type": "string",
            "enum": [
              "distinct",
              "equivalent",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "candidate_ref",
          "relation",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "duplicate_of_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "extraction_omission",
              "source_ambiguity",
              "proof_gap",
              "applicability",
              "identity_ambiguity",
              "coverage",
              "protocol_error",
              "other"
            ]
          },
          "scope": {
            "type": "string"
          },
          "subject_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "extraction",
                "identity",
                "bound",
                "profile",
                "publication",
                "expansion"
              ]
            }
          },
          "message": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "resolves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "issue_id",
          "kind",
          "scope",
          "subject_refs",
          "blocks",
          "message",
          "evidence_refs",
          "resolves"
        ],
        "additionalProperties": false
      }
    },
    "required_changes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "subject_ref",
    "candidate_ref",
    "verdict",
    "reason",
    "scope_assessment",
    "well_posedness_assessment",
    "value_assessment",
    "pending_comparisons",
    "duplicate_of_ref",
    "issues",
    "required_changes"
  ],
  "additionalProperties": false
}
