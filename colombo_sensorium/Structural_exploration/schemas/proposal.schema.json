{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "proposal",
  "type": "object",
  "properties": {
    "research_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "candidate_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identity_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "profile_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "prepared_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "change_summary": {
      "type": "string"
    },
    "base_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "inventory_version": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "update",
        "new"
      ]
    }
  },
  "required": [
    "research_ref",
    "candidate_ref",
    "identity_ref",
    "profile_ref",
    "prepared_ref",
    "change_summary",
    "base_version",
    "inventory_version",
    "mode"
  ],
  "additionalProperties": false
}
