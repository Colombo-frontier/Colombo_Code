{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "identity",
  "type": "object",
  "properties": {
    "candidate_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decision": {
      "type": "string",
      "enum": [
        "existing",
        "new",
        "unresolved"
      ]
    },
    "setting_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "view_mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "candidate_view_id": {
            "type": "string"
          },
          "atlas_view_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "candidate_view_id",
          "atlas_view_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "normalization": {
      "type": "string"
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "setting_id": {
            "type": "string"
          },
          "relation": {
            "type": "string",
            "enum": [
              "same",
              "different",
              "related",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        },
        "required": [
          "setting_id",
          "relation",
          "reason",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "retrieval_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "recall_audit": {
      "type": "object",
      "properties": {
        "strategies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "inventory_version": {
          "type": "string"
        }
      },
      "required": [
        "strategies",
        "unresolved_ids",
        "reason",
        "inventory_version"
      ],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "extraction_omission",
              "source_ambiguity",
              "proof_gap",
              "applicability",
              "identity_ambiguity",
              "coverage",
              "protocol_error",
              "other"
            ]
          },
          "scope": {
            "type": "string"
          },
          "subject_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "extraction",
                "identity",
                "bound",
                "profile",
                "publication"
              ]
            }
          },
          "message": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "resolves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "issue_id",
          "kind",
          "scope",
          "subject_refs",
          "blocks",
          "message",
          "evidence_refs",
          "resolves"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "candidate_ref",
    "decision",
    "setting_id",
    "view_mapping",
    "normalization",
    "comparisons",
    "retrieval_ref",
    "recall_audit",
    "issues"
  ],
  "additionalProperties": false
}
