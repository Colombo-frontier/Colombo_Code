{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "handoff",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "needs_materials",
        "blocked"
      ]
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "summary": {
      "type": "string"
    },
    "checkpoint_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "status",
    "artifact_refs",
    "summary",
    "checkpoint_ref"
  ],
  "additionalProperties": false
}
