{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "paper",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "arxiv_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publication_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "required": [
    "title",
    "doi",
    "arxiv_id",
    "urls",
    "publication_events",
    "provenance"
  ],
  "additionalProperties": true
}
