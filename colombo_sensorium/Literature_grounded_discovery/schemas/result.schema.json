{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "result",
  "type": "object",
  "properties": {
    "result_id": {
      "type": "string"
    },
    "comparison_key": {
      "type": "object",
      "properties": {
        "setting_id": {
          "type": "string"
        },
        "view_id": {
          "type": "string"
        },
        "guarantee_id": {
          "type": "string"
        },
        "quantity_id": {
          "type": "string"
        },
        "resource_projection_id": {
          "type": "string"
        },
        "regime_id": {
          "type": "string"
        }
      },
      "required": [
        "setting_id",
        "view_id",
        "guarantee_id",
        "quantity_id",
        "resource_projection_id",
        "regime_id"
      ],
      "additionalProperties": false
    },
    "direction": {
      "type": "string",
      "enum": [
        "upper",
        "lower",
        "impossibility",
        "infeasibility"
      ]
    },
    "statement": {
      "type": "string"
    },
    "formula_latex": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "parameter_region": {
      "type": "string"
    },
    "algorithm_scope": {
      "type": "string"
    },
    "witness_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "guarantee": {
      "type": "string"
    },
    "resource_accounting": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "enum": [
        "published_theorem",
        "analyst_transfer",
        "analyst_derivation"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "source_locators": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "version": {
            "type": "string",
            "description": "Must equal the version of the formal source object for that source_ref exactly; do not substitute the arXiv version label of a paper. Inspect the actual version first with source_read or artifact_get."
          },
          "locator": {
            "type": "string"
          }
        },
        "required": [
          "source_ref",
          "version",
          "locator"
        ],
        "additionalProperties": false
      }
    },
    "proof_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "quarantined"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "extraction_omission",
              "source_ambiguity",
              "proof_gap",
              "applicability",
              "identity_ambiguity",
              "coverage",
              "protocol_error",
              "other"
            ]
          },
          "scope": {
            "type": "string"
          },
          "subject_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "extraction",
                "identity",
                "bound",
                "profile",
                "publication"
              ]
            }
          },
          "message": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "resolves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "issue_id",
          "kind",
          "scope",
          "subject_refs",
          "blocks",
          "message",
          "evidence_refs",
          "resolves"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "result_id",
    "comparison_key",
    "direction",
    "statement",
    "formula_latex",
    "conditions",
    "parameter_region",
    "algorithm_scope",
    "witness_type",
    "guarantee",
    "resource_accounting",
    "origin",
    "source_refs",
    "source_locators",
    "proof_refs",
    "status",
    "issues"
  ],
  "additionalProperties": false
}
