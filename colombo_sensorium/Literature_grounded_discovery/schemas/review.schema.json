{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review",
  "type": "object",
  "properties": {
    "subject_ref": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "review_type": {
      "type": "string",
      "enum": [
        "extraction",
        "identity",
        "profile"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "approve",
        "revise",
        "defer"
      ]
    },
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "subject_id": {
            "type": "string"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "approve",
              "revise",
              "defer"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "subject_id",
          "verdict",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "extraction_omission",
              "source_ambiguity",
              "proof_gap",
              "applicability",
              "identity_ambiguity",
              "coverage",
              "protocol_error",
              "other"
            ]
          },
          "scope": {
            "type": "string"
          },
          "subject_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "blocks": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "extraction",
                "identity",
                "bound",
                "profile",
                "publication"
              ]
            }
          },
          "message": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          },
          "resolves": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "issue_id",
          "kind",
          "scope",
          "subject_refs",
          "blocks",
          "message",
          "evidence_refs",
          "resolves"
        ],
        "additionalProperties": false
      }
    },
    "approved_bound_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "coverage_audit": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "check_id": {
                "type": "string",
                "enum": [
                  "zero_query",
                  "exact_reconstruction",
                  "coarse_accuracy",
                  "dimension_endpoints",
                  "confidence_endpoints",
                  "degenerate_instances",
                  "envelopes_and_monotonicity",
                  "moment_contracts",
                  "supported_transfers"
                ]
              },
              "scope": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "not_applicable",
                  "unresolved"
                ]
              },
              "reason": {
                "type": "string"
              },
              "result_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              },
              "proof_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            },
            "required": [
              "check_id",
              "scope",
              "status",
              "reason",
              "result_refs",
              "proof_refs"
            ],
            "additionalProperties": false
          },
          "minItems": 9,
          "description": "Check nine boundary categories per view/regime. Give specific reasons for inapplicability; the template is not a proof of mathematical exhaustiveness."
        },
        "resolved_issue_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "carried_issue_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "new_blocker_justifications": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "issue_id": {
                "type": "string"
              },
              "category": {
                "type": "string",
                "enum": [
                  "correctness",
                  "evidence",
                  "contract",
                  "coverage"
                ]
              },
              "why_new": {
                "type": "string"
              },
              "affected_subjects": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "basis": {
                "type": "string",
                "enum": [
                  "current_claim_invalid",
                  "frozen_obligation",
                  "first_review_omission",
                  "new_evidence_defect",
                  "new_construction"
                ]
              },
              "frozen_issue_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "affected_profile_pointers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "issue_id",
              "category",
              "why_new",
              "affected_subjects"
            ],
            "additionalProperties": false
          }
        },
        "followups": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "reason_nonblocking": {
                "type": "string"
              },
              "obligation_id": {
                "type": "string"
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "source_review_ref": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^sha256:[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "retained_claims_valid": {
                "const": true
              }
            },
            "required": [
              "scope",
              "description",
              "reason_nonblocking"
            ],
            "additionalProperties": false,
            "description": "A nonblocking extension whose existing claims remain valid. In anchored tasks all fields are required. obligation_id binds the native joint-parameter synthesis obligation; persist the same record in research.coverage_ledger.followups and profile.delivery_followups. A reviewer cannot add it after signing the frozen five files."
          }
        },
        "reuse_context_ref": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reused_bound_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "delivery_scope_ref": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "scope",
        "checks",
        "resolved_issue_ids",
        "carried_issue_ids",
        "new_blocker_justifications",
        "followups",
        "reuse_context_ref",
        "reused_bound_ids"
      ],
      "additionalProperties": false,
      "description": "A new profile review checks coverage item by item and consolidates mandatory obligations. A second review explicitly carries forward/resolves old issues; new coverage blockers explain new evidence or first-review omissions. New counterexamples or invalid dependencies may always block. Reuse is limited to per-bound candidates whose unchanged dependencies the controller has verified; the current proposal still requires approval."
    },
    "proof_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proof_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "scope": {
            "type": "string",
            "enum": [
              "standalone_proposition",
              "standalone_proposition_explicit_context"
            ]
          },
          "assumptions_complete": {
            "const": true
          },
          "context_pointers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reason": {
            "type": "string"
          },
          "execution_check": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              },
              "check_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "required",
              "reason",
              "check_refs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "proof_ref",
          "scope",
          "assumptions_complete",
          "context_pointers",
          "reason"
        ],
        "additionalProperties": false
      },
      "description": "Independent credentials for fixed propositions, not current bound adoption. Verify complete assumptions, original proof and mathematical dependencies. context_pointers includes /common_specification and every necessary definition. standalone_proposition retains legacy conservative hashing; standalone_proposition_explicit_context uses the explicitly complete context without implicitly hashing the whole parameters array. The new scope requires actual review of all mathematical parameters, variables, norms and quantifiers, including excluded old-context fields; changing a scope cannot delete a real assumption. The controller computes hashes. Empty credentials do not waive scientific review."
    },
    "proof_execution_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proof_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "execution_check": {
            "type": "object",
            "properties": {
              "required": {
                "type": "boolean"
              },
              "reason": {
                "type": "string"
              },
              "check_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "required",
              "reason",
              "check_refs"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "proof_ref",
          "execution_check"
        ],
        "additionalProperties": false
      },
      "description": "Execution applicability for formal proofs supporting currently adopted bounds, including when no reuse credential is issued. May instead use proof_approvals.execution_check for the same proof. If both are present they must agree; declining reusable credentials does not waive actual scientific checks."
    },
    "proof_scope_revalidations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "proof_ref": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "changes_reviewed": {
            "const": true
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "proof_ref",
          "candidate_id",
          "changes_reviewed",
          "reason"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true,
      "description": "Independent current scope re-review for a controller-listed proof_scope_revalidation_candidates entry whose proof and mathematical dependencies remain stable. Inspect the original credential, context_changes and all new/historical issue occurrences, then issue a current proof_approvals credential with complete assumptions and scopes. Bind the current candidate_id; do not list this proof in reused_proof_refs. This is newly reviewed applicability/context, not automatic reuse or permission to ignore changed assumptions, source/proof defects, or older issue occurrences."
    },
    "proof_issue_scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "affected_proof_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "uniqueItems": true
          },
          "scope_complete": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "occurrence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "issue_id",
          "affected_proof_refs",
          "scope_complete",
          "reason"
        ],
        "additionalProperties": false
      },
      "description": "Cover every scientific issue in profile/research/review that blocks bound/profile/publication and specify its impact on standalone proof propositions. Unknown/omitted scope requires full review. An empty affected list is allowed only after verifying that the issue is unrelated to the proof. An unresolved blocker directly targeting that proof cannot be overridden as unaffected."
    },
    "issue_scope_version": {
      "type": "string",
      "enum": [
        "snapshot-bound-scope",
        "occurrence-bound-scope"
      ]
    },
    "bound_approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bound_id": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "bound_applicability"
            ]
          },
          "assumptions_complete": {
            "const": true
          },
          "context_pointers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "bound_id",
          "scope",
          "assumptions_complete",
          "context_pointers",
          "reason"
        ],
        "additionalProperties": false
      },
      "description": "Independent per-bound applicability credentials. Include /common_specification and all necessary definitions in context_pointers; effective views, global parameters and pinned dependencies remain mandatory. This does not replace approved_bound_ids or final independent review."
    },
    "bound_issue_scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "affected_bound_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "scope_complete": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "occurrence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "issue_id",
          "affected_bound_ids",
          "scope_complete",
          "reason"
        ],
        "additionalProperties": false
      },
      "description": "Explicit impact of each scientific issue on registered bounds. Unknown scope remains conservative. With issue_scope_version snapshot-bound-scope, verified whole-snapshot provenance references are separated from the unchanged mathematical issue semantics; all older credentials remain conservative."
    },
    "projection_repairs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "issue_id": {
            "type": "string"
          },
          "file": {
            "type": "string",
            "enum": [
              "identity.json",
              "classification.json",
              "human_tags.json",
              "machine_tags.json"
            ]
          },
          "pointer": {
            "type": "string",
            "pattern": "^/"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "issue_id",
          "file",
          "pointer",
          "reason"
        ],
        "additionalProperties": false
      },
      "description": "Explicit sidecar-only protocol defects. Each row identifies an issue of kind protocol_error blocking only profile/publication and a file-relative JSON pointer. When these are all publication blockers, the controller regenerates the sidecars once and requests fresh independent review without an author rewrite. This never approves a bound or resolves a scientific issue."
    },
    "proof_reuse_context_ref": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "When reusing proofs or independently revalidating a listed scope candidate, bind the current input proof_context_ref; an old review or producer-reported catalog cannot replace it. This binding does not turn scope revalidation into automatic reuse."
    },
    "reused_proof_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "uniqueItems": true,
      "description": "List only candidates verified by the controller in this run and explicitly approved by current proof_approvals. Reuse concerns standalone propositions only; current bound applicability, coverage/envelopes/reader/five files, and every active bound still require new review."
    },
    "joint_checks": {
      "type": "object",
      "properties": {
        "parameter_roles": {
          "type": "boolean"
        },
        "guarded_envelopes": {
          "type": "boolean"
        },
        "domain_accounting": {
          "type": "boolean"
        },
        "improvement_regions": {
          "type": "boolean"
        },
        "provenance": {
          "type": "boolean"
        },
        "display_consistency": {
          "type": "boolean"
        }
      },
      "required": [
        "parameter_roles",
        "guarded_envelopes",
        "domain_accounting",
        "improvement_regions",
        "provenance",
        "display_consistency"
      ],
      "additionalProperties": false
    },
    "prepared_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "For proposal approvals, copy bundle_hash from the independently inspected prepared object."
    }
  },
  "required": [
    "subject_ref",
    "review_type",
    "verdict",
    "assessments",
    "issues",
    "approved_bound_ids",
    "summary"
  ],
  "additionalProperties": false
}
