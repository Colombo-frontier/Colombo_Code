{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:complexity-atlas:identity:component-profile",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "setting_id",
    "normalization_version",
    "profile_sha256",
    "axes",
    "parameters",
    "views",
    "view_override_policy",
    "matching_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "component-profile"
    },
    "record_type": {
      "const": "setting_identity"
    },
    "setting_id": {
      "type": "string"
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "axes": {
      "type": "object",
      "required": [
        "task",
        "instance_model",
        "oracle_interface",
        "output",
        "metric",
        "resource_model"
      ]
    },
    "views": {
      "type": "array"
    }
  }
}
