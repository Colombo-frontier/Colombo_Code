{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:complexity-atlas:profile:native-profile",
  "title": "Source-faithful active setting profile",
  "type": "object",
  "required": [
    "schema_version",
    "setting_id",
    "title",
    "primary_domain",
    "common_specification",
    "views",
    "parameters",
    "symbols",
    "quantities",
    "resource_projections",
    "regimes",
    "bounds",
    "comparisons",
    "summary_status",
    "proofs",
    "evidence",
    "references",
    "facets",
    "relations",
    "aliases",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "native-profile"
    },
    "setting_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "primary_domain": {
      "type": "string"
    },
    "common_specification": {
      "type": "object",
      "required": [
        "task",
        "model",
        "oracle",
        "output",
        "metric",
        "resource"
      ]
    },
    "summary_status": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_schema_version",
        "source_snapshot",
        "source_profile",
        "source_json_sha256",
        "source_order"
      ]
    },
    "views": {
      "type": "array"
    },
    "parameters": {
      "type": "array"
    },
    "symbols": {
      "type": "array"
    },
    "quantities": {
      "type": "array"
    },
    "resource_projections": {
      "type": "array"
    },
    "regimes": {
      "type": "array"
    },
    "bounds": {
      "type": "array"
    },
    "comparisons": {
      "type": "array"
    },
    "proofs": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "references": {
      "type": "array"
    },
    "facets": {
      "type": "array"
    },
    "relations": {
      "type": "array"
    },
    "aliases": {
      "type": "array"
    }
  },
  "propertyNames": {
    "not": {
      "enum": [
        "coverage",
        "coverage_note"
      ]
    }
  },
  "$comment": "Nested forbidden-field checks, source fidelity, foreign keys, and comparison scopes are enforced by validate_data.py."
}
