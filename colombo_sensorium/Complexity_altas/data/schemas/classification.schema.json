{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:complexity-atlas:classification:1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "taxonomy_version",
    "record_type",
    "setting_id",
    "profile_sha256",
    "axes",
    "tags",
    "operation_bindings",
    "unparsed_count",
    "unclassified_axes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "setting_classification"
    },
    "setting_id": {
      "type": "string",
      "minLength": 1
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "axes": {
      "type": "object",
      "required": [
        "TASK",
        "MODEL",
        "ORACLE",
        "ALGORITHMS",
        "OUTPUT",
        "METRIC",
        "GUARANTEE",
        "RESOURCE"
      ],
      "additionalProperties": false,
      "properties": {
        "TASK": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "MODEL": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ORACLE": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ALGORITHMS": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "OUTPUT": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "METRIC": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "GUARANTEE": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "RESOURCE": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "axis",
          "group",
          "value",
          "label",
          "source_pointers",
          "view_ids",
          "evidence_state",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(TASK|MODEL|ORACLE|ALGORITHMS|OUTPUT|METRIC|GUARANTEE|RESOURCE):[a-z_]+:[a-z0-9_]+$"
          },
          "axis": {
            "enum": [
              "TASK",
              "MODEL",
              "ORACLE",
              "ALGORITHMS",
              "OUTPUT",
              "METRIC",
              "GUARANTEE",
              "RESOURCE"
            ]
          },
          "group": {
            "type": "string"
          },
          "value": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "source_pointers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^/"
            }
          },
          "view_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidence_state": {
            "enum": [
              "structured",
              "explicit_text",
              "legacy_facet"
            ]
          }
        }
      }
    },
    "operation_bindings": {
      "type": "array"
    },
    "unparsed_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$comment": "classify_profiles.py additionally validates every pointer, view scope, operation binding, source hash, global group and tag ID."
}
