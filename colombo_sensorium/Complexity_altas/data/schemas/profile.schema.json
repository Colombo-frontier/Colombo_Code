{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:complexity-atlas:profile:6.1.0",
  "title": "Source-faithful active setting profile",
  "type": "object",
  "required": [
    "schema_version",
    "setting_id",
    "title",
    "primary_domain",
    "common_specification",
    "views",
    "parameters",
    "symbols",
    "quantities",
    "resource_projections",
    "regimes",
    "bounds",
    "comparisons",
    "summary_status",
    "proofs",
    "evidence",
    "references",
    "facets",
    "relations",
    "aliases",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "6.1.0"
    },
    "setting_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "primary_domain": {
      "type": "string"
    },
    "common_specification": {
      "type": "object",
      "required": [
        "task",
        "model",
        "oracle",
        "output",
        "metric",
        "resource"
      ]
    },
    "summary_status": {
      "type": "object",
      "properties": {
        "scope": {
          "const": "documented_comparison_domain"
        },
        "gap_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "logarithmic_gap",
              "polynomial_gap",
              "other_quantified_gap"
            ]
          }
        },
        "badges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "label"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "fully_optimal",
                  "logarithmic_gap",
                  "polynomial_gap",
                  "other_quantified_gap",
                  "bounds_missing"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "special_statuses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "code",
              "label"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "joint_budget_unclosed",
                  "infinite_complexity",
                  "infeasible_task"
                ]
              },
              "label": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      },
      "required": [
        "badges",
        "comparison_count",
        "gap_classes",
        "missing_sides",
        "scope",
        "special_statuses",
        "status_counts"
      ]
    },
    "provenance": {
      "type": "object",
      "required": [
        "source_schema_version",
        "source_snapshot",
        "source_json_sha256",
        "source_order"
      ]
    },
    "views": {
      "type": "array"
    },
    "parameters": {
      "type": "array"
    },
    "symbols": {
      "type": "array"
    },
    "quantities": {
      "type": "array"
    },
    "resource_projections": {
      "type": "array"
    },
    "regimes": {
      "type": "array"
    },
    "bounds": {
      "type": "array"
    },
    "comparisons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "status": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "optimal",
                  "logarithmic_gap",
                  "polynomial_gap",
                  "other_quantified_gap",
                  "missing_upper",
                  "missing_lower",
                  "missing_both",
                  "joint_budget_unclosed",
                  "infinite_complexity",
                  "infeasible_task"
                ]
              }
            },
            "required": [
              "code",
              "missing_sides"
            ]
          }
        }
      }
    },
    "proofs": {
      "type": "array"
    },
    "evidence": {
      "type": "array"
    },
    "references": {
      "type": "array"
    },
    "facets": {
      "type": "array"
    },
    "relations": {
      "type": "array"
    },
    "aliases": {
      "type": "array"
    }
  },
  "propertyNames": {
    "not": {
      "enum": [
        "coverage",
        "coverage_note"
      ]
    }
  },
  "$comment": "Nested forbidden-field checks, source fidelity, foreign keys, and comparison scopes are enforced by validate_data.py."
}
