      "source_fields": {
        "assumptions": [
          {
            "id": "SO_ZO_N10_schatten_hessian_gaussian__colombo_assumption_30789bb3499a",
            "property_code": "explicit_model_clause",
            "subject_id": "SO_ZO_N10_schatten_hessian_gaussian__instance",
            "description": "For $p\\in[2,\\infty]$, $f:\\mathbb R^d\\to\\mathbb R$ is $C^2$ and satisfies $$\\nabla^2 f(x)\\succeq\\mu I,\\qquad\\|\\nabla^2f(x)-\\nabla^2f(y)\\|_{S_p}\\le\\rho\\|x-y\\|_2$$ for every $x,y\\in\\mathbb R^d$. The unique global minimizer obeys $\\|x_*\\|_2\\le R$.",
            "scope": "The domain stated in this clause."
          },
          {
            "id": "SO_ZO_N10_schatten_hessian_gaussian__colombo_assumption_36c144d3a66f",
            "property_code": "explicit_model_clause",
            "subject_id": "SO_ZO_N10_schatten_hessian_gaussian__instance",
            "description": "The Schatten norm $\\|A\\|_{S_p}$ is the ell-p norm of the singular values, with $S_2$ the Frobenius norm and $S_\\infty$ the operator norm. There is no global upper bound on the Hessian or gradient. The known minimizer ball does not constrain queries or output.",
            "scope": "The domain stated in this clause."
          }
        ],
        "properties": {
          "convexity": "strongly_convex",
          "smoothness": [
            "hessian_lipschitz"
          ]
        }
