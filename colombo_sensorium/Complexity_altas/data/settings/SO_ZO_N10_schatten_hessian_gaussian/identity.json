    "oracle_interface": {
      "state": "source_structured",
      "source_pointer": "/common_specification/oracle",
      "source_fields": {
        "operation": "One query at any $x_t\\in\\mathbb R^d$ returns $Y_t=f(x_t)+\\xi_t$, where the noises are fresh independent $N(0,1)$ variables, independent of the algorithmic seed and past observations. Opposite-point observations have independent noise; no same-sample reuse or noiseless values are available. Public inputs are $d,p,\\mu,\\rho,R$ and a horizon $T$ or target error $\\varepsilon$. The objective is hidden.",
        "hidden_objects": [
          "SO_ZO_N10_schatten_hessian_gaussian__instance"
        ],
