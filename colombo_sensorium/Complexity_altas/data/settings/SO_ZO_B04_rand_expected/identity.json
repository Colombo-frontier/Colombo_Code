          "solution_goal": "goldstein_normal_cone_stationarity",
          "code": "single_objective_optimization",
          "description_paragraphs": [
            "Find a feasible point in the known closed convex set $X$ with a sufficiently small Goldstein normal-cone residual."
          ],
