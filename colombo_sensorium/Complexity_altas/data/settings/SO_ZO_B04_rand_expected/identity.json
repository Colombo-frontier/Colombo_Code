          "code": "output_space",
          "description_paragraphs": [
            "Return $\\widehat{x}\\in X$. The output may be an unqueried point, a random choice among previous points, or an average or convex combination that remains in the stated space. No function value, gradient, inner solution, or accuracy certificate must accompany the output."
          ]
        },
        "metric": {
          "native_metric_wording": "$\\ell(I,x)=\\min_{g\\in\\partial_\\rho f(x)}\\operatorname{dist}(-g,N_X(x))$, where $N_X(x)=\\{v:\\langle v,y-x\\rangle\\le0\\ \\forall y\\in X\\}$; the criterion is evaluated only at $x\\in X$. The target tolerance is $\\varepsilon$.",
          "formula_latex": "\\min_{g\\in\\partial_\\rho f(\\widehat{x})}\\operatorname{dist}(-g,N_X(\\widehat{x}))",
          "threshold_latex": "\\varepsilon",
          "code": "goldstein_normal_cone_stationarity",
          "description_paragraphs": [
            "$\\ell(I,x)=\\min_{g\\in\\partial_\\rho f(x)}\\operatorname{dist}(-g,N_X(x))$, where $N_X(x)=\\{v:\\langle v,y-x\\rangle\\le0\\ \\forall y\\in X\\}$; the criterion is evaluated only at $x\\in X$. The target tolerance is $\\varepsilon$.",
            "$\\partial_\\rho f(x)=\\operatorname{conv}\\bigcup_{\\|y-x\\|_2\\le\\rho}\\partial f(y)$, where $\\partial f$ is the Clarke subdifferential of the function on the ambient space."
