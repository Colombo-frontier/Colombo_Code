      "source_fields": {
        "id": "ONX_FED_TWO_LIPSCHITZ_ora_415a9ed217",
        "operation_code": "distributed_two_point",
        "target_object": "ONX_FED_TWO_LIPSCHITZ_obj_bdafbaec7e",
        "query_signature": "Each client simultaneously submits $x_t^{m,1},x_t^{m,2}\\in\\mathbb R^d$ and receives exact values of the same current local function at both points. The second point cannot depend on the first response. There is no independent measurement noise; variance from randomized directions is part of the estimator analysis. Both query points incur loss. The comparator ball $\\{x:\\|x\\|_2\\le B\\}$ does not restrict all queries. Inputs $M,d,T,L_{\\mathrm{comm}},R_{\\mathrm{comm}},G,B,\\zeta$ are public. Received feedback may be stored and reused computationally. No unrevealed historical information or extra queries to exhausted samples are available; any within-round full-function or common-sample access must be explicit.",
        "response_signature": {
          "feedback": "two exact values of the same current local function per client/round",
          "noise": "no measurement noise; random directions induce estimator variance",
          "coupling": "simultaneous pair; second query cannot adapt to first value"
        },
        "domain_ref": "ONX_FED_TWO_LIPSCHITZ_dom_632fb39ddd",
        "feedback_quality": {
          "feedback": "two exact values of the same current local function per client/round",
          "noise": "no measurement noise; random directions induce estimator variance",
          "coupling": "simultaneous pair; second query cannot adapt to first value"
        },
        "access_schedule_ref": "ONX_FED_TWO_LIPSCHITZ_pro_fc23281917",
        "cost_rule_ref": "ONX_FED_TWO_LIPSCHITZ_res_710d1a4207",
        "display_label_zh": "Simultaneous two-point values from clients."
      },
      "target_object_registry": [
        {
          "id": "ONX_FED_TWO_LIPSCHITZ_obj_bdafbaec7e",
          "type": "online_environment",
          "definition": "There are $M$ clients interacting simultaneously in $\\mathbb R^d$ for $T=L_{\\mathrm{comm}}R_{\\mathrm{comm}}$ rounds each. They synchronize once every $L_{\\mathrm{comm}}$ rounds, for $R_{\\mathrm{comm}}$ synchronizations. Each $f_t^m:\\mathbb R^d\\to\\mathbb R$ is differentiable and convex, with uniform Euclidean Lipschitz constant $G$ on the whole space. $$f_t(x)=\\frac1M\\sum_{m=1}^{M}f_t^m(x),\\qquad \\frac1M\\sum_{m=1}^{M}\\|\\nabla f_t^m(x)-\\nabla f_t(x)\\|_2^2\\le\\zeta^2\\quad(\\forall t,x).$$ The adversary may depend on all past actions and the algorithm, but not on its current private randomness. All clients share the same hindsight comparator: $$x^\\star\\in\\operatorname*{arg\\,min}_{\\|x\\|_2\\le B}\\sum_{t=1}^{T}\\sum_{m=1}^{M}f_t^m(x).$$"
        }
      ],
