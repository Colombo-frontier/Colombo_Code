      "parameter_domain_latex": "d\\in\\mathbb N_{\\ge1},\\quad L,R>0,\\quad\\mu\\ge0,\\quad0<\\sigma_{\\rm dir}\\le\\sigma,\\quad1<\\alpha\\le2,\\quad0<\\delta<1/2,\\quad T\\in\\mathbb N_{\\ge1}"
