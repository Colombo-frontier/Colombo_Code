    "oracle_interface": {
      "state": "source_structured",
      "source_pointer": "/common_specification/oracle",
      "source_fields": {
        "operation": "Before each action, at most Q calls to an exact strong separation oracle may be made. On any query z in the full Euclidean space, it returns inside if z belongs to K, or a unit vector a satisfying $\\sup_{x\\in K}\\langle a,x\\rangle<\\langle a,z\\rangle$. The oracle may choose any valid response. The learner then plays $w_t\\in K$ and receives the current convex loss and a subgradient $g_t\\in\\partial f_t(w_t)$ with $\\|g_t\\|\\le G$. The upper algorithms use only the subgradient. All preprocessing access to K is charged from round 1; unused calls cannot be carried to a future round. Arithmetic and tests against explicitly stored inequalities are not unknown-body queries.",
        "hidden_objects": [
          "ONX_OCO_SEPARATION_PER_ROUND__instance"
        ],
