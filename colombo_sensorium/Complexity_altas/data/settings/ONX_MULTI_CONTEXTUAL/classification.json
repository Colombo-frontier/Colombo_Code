      "source_fields": {
        "id": "ONX_MULTI_CONTEXTUAL_ora_6f0f6f3180",
        "operation_code": "batched_task_rewards",
        "target_object": "ONX_MULTI_CONTEXTUAL_obj_57f43b71b2",
        "query_signature": "Submit all $M$ actions simultaneously, then receive all rewards together. No action may use an earlier response from the same batch. $$Y_{t,m}=\\langle x_{t,m},\\theta_m\\rangle+\\eta_{t,m}.$$ Conditional on the past and chosen actions, noise has mean zero and is $1$-sub-Gaussian. Centralized causal learning is allowed. Inputs $M,d,r,T,\\delta_{\\mathrm{conf}}$ and current action sets are public; the shared representation $B$ and individual $w_m$ are hidden. Received feedback may be stored and reused computationally. No unrevealed historical information or extra queries to exhausted samples are available; any within-round full-function or common-sample access must be explicit.",
        "response_signature": {
          "feedback": "batch of M scalar rewards <x_(t,m),theta_m>+eta_(t,m)",
          "noise": "conditionally zero-mean 1-sub-Gaussian given history and current selected actions"
        },
        "domain_ref": "ONX_MULTI_CONTEXTUAL_dom_6488c80ee2",
        "feedback_quality": {
          "feedback": "batch of M scalar rewards <x_(t,m),theta_m>+eta_(t,m)",
          "noise": "conditionally zero-mean 1-sub-Gaussian given history and current selected actions"
        },
        "access_schedule_ref": "ONX_MULTI_CONTEXTUAL_pro_3bab662a5e",
        "cost_rule_ref": "ONX_MULTI_CONTEXTUAL_res_dcee84d9d6",
        "display_label_zh": "Rewards for tasks in a simultaneous batch"
      },
      "target_object_registry": [
        {
          "id": "ONX_MULTI_CONTEXTUAL_obj_57f43b71b2",
          "type": "online_environment",
          "definition": "There are $M$ parallel tasks, each with $T$ rounds and one action per task per round. The parameter matrix and shared representation satisfy $$\\Theta=[\\theta_1,\\ldots,\\theta_M],\\qquad \\operatorname{rank}(\\Theta)\\le r,\\qquad \\|\\theta_m\\|_2\\le1.$$. Current action sets $\\mathcal A_{t,m}\\subseteq B_2^d(1)$ may depend on past history and are revealed before the full action batch. No task-diversity or covariance-eigenvalue lower bound is imposed."
        }
      ],
