        "id": "ONX_LEX_LIPSCHITZ_KNOWN_ora_143e9a9079",
        "operation_code": "selected_reward_vector",
        "target_object": "ONX_LEX_LIPSCHITZ_KNOWN_obj_1d77b27b60",
        "query_signature": "Choose an arm $x_t$, then observe all $m$ reward coordinates of that arm. Conditional on past observations and the current arm, each coordinate is $1$-sub-Gaussian around its fixed mean; coordinates need not be independent. $$\\mathbb E\\!\\left[e^{s(Y_{t,i}-\\mu_i(x_t))}\\mid\\mathcal H_{t-1},x_t\\right]\\le e^{s^2/2}\\qquad(s\\in\\mathbb R,\\ 1\\le i\\le m).$$ Causal policies may use the public covering and activation interfaces. The metric space, $m,T,\\delta_{\\mathrm{conf}}$, and $\\lambda\\ge\\lambda_\\star$ are public. The mean functions and lexicographically optimal arm $x^\\star$ are hidden. Observed feedback may be stored and reused computationally; unrevealed past information and additional queries to exhausted samples are unavailable. Any within-round full-function or common-sample two-point access must be explicitly specified.",
        "response_signature": {
          "feedback": "all m coordinates of the selected arm reward vector",
          "noise": "each coordinate is conditionally 1-sub-Gaussian about its fixed mean given past data and current arm; cross-coordinate independence is not required",
          "queries": "one selected arm per round"
        },
        "domain_ref": "ONX_LEX_LIPSCHITZ_KNOWN_dom_133c9ac207",
