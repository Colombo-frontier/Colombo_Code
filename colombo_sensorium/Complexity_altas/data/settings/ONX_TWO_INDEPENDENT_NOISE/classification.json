      "source_fields": {
        "id": "ONX_TWO_INDEPENDENT_NOISE_ora_a0bc30d8af",
        "operation_code": "two_point_independent_noise",
        "target_object": "ONX_TWO_INDEPENDENT_NOISE_obj_441e3ae6a1",
        "query_signature": "$$Y_t^+=f(z_t^+)+\\varepsilon_t^+,\\qquad Y_t^-=f(z_t^-)+\\varepsilon_t^-,\\qquad \\varepsilon_t^\\pm\\overset{\\mathrm{i.i.d.}}\\sim\\mathcal N(0,\\sigma^2).$$ The center $x_t$ and both probes $z_t^+,z_t^-$ must be submitted together before either observation is received. Noise is independent across all queries, with no shared seed. Only the center loss $f(x_t)$ is incurred; probe values are information queries and do not enter that round's loss. Causal policies may submit two simultaneous probes per round. Inputs $d,T,R,L,\\sigma$ are public and $f$ is hidden. Both probes and the center must lie in the same ball. Past feedback may be stored and reused computationally; unrevealed past information and additional queries to exhausted samples are unavailable. Any within-round full-function or common-sample access must be explicit.",
        "response_signature": {
          "feedback": "Y_t_plus=f(z_t_plus)+epsilon_t_plus, Y_t_minus=f(z_t_minus)+epsilon_t_minus",
          "noise": "independent N(0,sigma^2), independent across all calls",
          "coupling": "no shared seed; second query committed before either response",
          "loss_bearing": "center f(x_t); probes are pure information queries"
        },
