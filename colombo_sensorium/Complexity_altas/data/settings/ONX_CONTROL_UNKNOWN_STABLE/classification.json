      "source_fields": {
        "id": "ONX_CONTROL_UNKNOWN_STABLE_ora_1ae95ef333",
        "operation_code": "state_and_full_cost",
        "target_object": "ONX_CONTROL_UNKNOWN_STABLE_obj_6997e67ad6",
        "query_signature": "Observe the full state $x_t$, choose $u_t$, incur $c_t(x_t,u_t)$, and then receive the complete current cost function and next state. Neither $A,B$ nor the disturbance is directly revealed. Arbitrary causal controllers are allowed; the algorithm is not restricted to a particular linear feedback form. Inputs $d_x,d_u,T,G,W,K_0,\\gamma,C_{\\mathrm{stab}},C_{\\mathrm{ctrl}},k_{\\mathrm{ctrl}},\\delta_{\\mathrm{conf}}$ are public. Received feedback may be stored and reused computationally. No unrevealed historical information or extra queries to exhausted samples are available; any within-round full-function or common-sample access must be explicit.",
        "response_signature": {
          "feedback": "full current/next state and full current cost after action",
          "hidden": "A,B and disturbances are not directly supplied"
        },
        "domain_ref": "ONX_CONTROL_UNKNOWN_STABLE_dom_a60f8ade3f",
        "feedback_quality": {
          "feedback": "full current/next state and full current cost after action",
          "hidden": "A,B and disturbances are not directly supplied"
        },
        "access_schedule_ref": "ONX_CONTROL_UNKNOWN_STABLE_pro_5fae6bd530",
        "cost_rule_ref": "ONX_CONTROL_UNKNOWN_STABLE_res_7add186f80",
        "display_label_zh": "The complete state and cost function."
      },
      "target_object_registry": [
        {
          "id": "ONX_CONTROL_UNKNOWN_STABLE_obj_6997e67ad6",
          "type": "online_environment",
          "definition": "$$x_{t+1}=Ax_t+Bu_t+w_t,\\qquad x_t\\in\\mathbb R^{d_x},\\quad u_t\\in\\mathbb R^{d_u},\\quad x_0=0.$$ The matrices $A,B$ are fixed and unknown. The disturbance sequence is fixed before interaction and satisfies $\\|w_t\\|_2\\le W$; independent random noise is not assumed. The cost functions $c_t(x,u)$ are fixed in advance, differentiable, and convex. For every radius $D\\ge1$, $\\|x\\|_2,\\|u\\|_2\\le D$ implies $\\|\\nabla c_t(x,u)\\|_2\\le GD$. A stabilizer $K_0$ is known, and the closed-loop system admits the decomposition $$A-BK_0=QLQ^{-1},\\qquad \\|L\\|_2\\le1-\\gamma,\\qquad 0<\\gamma\\le1,$$ $$\\max\\{\\|A\\|_2,\\|B\\|_2,\\|K_0\\|_2,\\|Q\\|_2,\\|Q^{-1}\\|_2\\}\\le C_{\\mathrm{stab}}.$$ Strong controllability additionally requires the following matrix to have full row rank and satisfy $$C_k=[B,(A-BK_0)B,\\ldots,(A-BK_0)^{k_{\\mathrm{ctrl}}-1}B],\\qquad \\|(C_kC_k^{\\mathsf T})^{-1}\\|_2\\le C_{\\mathrm{ctrl}}.$$"
        }
      ],
      "derivative_reference_object_registry": []
    }
