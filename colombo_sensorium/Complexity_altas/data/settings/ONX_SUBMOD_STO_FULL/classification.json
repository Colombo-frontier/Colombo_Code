      "source_fields": {
        "id": "ONX_SUBMOD_STO_FULL_ora_bbdb7a6f89",
        "operation_code": "full_current_function",
        "target_object": "ONX_SUBMOD_STO_FULL_obj_e4e7a1db07",
        "query_signature": "Draw the current function independently. Choose $X_t$, incur $f_t(X_t)$, and then receive feedback. After acting, any subset $X$ may be queried against the same $f_t(X)$, providing full value-oracle access. Randomness comes from function sampling, without additional value noise. The distribution $\\mathcal D$, gap $\\Delta$, and optimal subset $X^\\star$ are hidden. Received feedback may be stored and reused computationally. No unrevealed historical information or extra queries to exhausted samples are available; any within-round full-function or common-sample access must be explicit.",
        "response_signature": {
          "feedback": "after choosing X_t, may evaluate f_t(X) for arbitrary subsets X",
          "noise": "stochasticity of f_t; no additional oracle noise"
        },
        "domain_ref": "ONX_SUBMOD_STO_FULL_dom_18ec1d62f9",
        "feedback_quality": {
          "feedback": "after choosing X_t, may evaluate f_t(X) for arbitrary subsets X",
          "noise": "stochasticity of f_t; no additional oracle noise"
        },
        "access_schedule_ref": "ONX_SUBMOD_STO_FULL_pro_5cd767de46",
        "cost_rule_ref": "ONX_SUBMOD_STO_FULL_res_e4b49e68c2",
        "display_label_zh": "Access to the complete current function"
      },
      "target_object_registry": [
        {
          "id": "ONX_SUBMOD_STO_FULL_obj_e4e7a1db07",
          "type": "online_environment",
          "definition": "An action is any subset of the ground set $[d]$. Random loss functions $f_t:2^{[d]}\\to[0,1]$ are drawn i.i.d. from an unknown distribution $\\mathcal D$, and each sample function is submodular. The mean function has a unique minimizing subset: $$\\bar f(X)=\\mathbb E_{f\\sim\\mathcal D}f(X),\\qquad X^\\star=\\operatorname*{arg\\,min}_{X\\subseteq[d]}\\bar f(X),$$ $$\\Delta=\\min_{X\\ne X^\\star}\\bigl(\\bar f(X)-\\bar f(X^\\star)\\bigr)>0.$$"
        }
      ],
      "derivative_reference_object_registry": []
    }
