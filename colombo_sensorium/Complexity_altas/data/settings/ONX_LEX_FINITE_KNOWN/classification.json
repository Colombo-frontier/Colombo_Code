      "source_fields": {
        "id": "ONX_LEX_FINITE_KNOWN_ora_e0d8da38e2",
        "operation_code": "selected_reward_vector",
        "target_object": "ONX_LEX_FINITE_KNOWN_obj_e645b31fe0",
        "query_signature": "Choose an arm $x_t$ and then observe all $m$ reward coordinates. Conditional on the past and current arm, each coordinate is $1$-sub-Gaussian around its fixed mean; coordinates need not be independent. $$\\mathbb E\\!\\left[e^{s(Y_{t,i}-\\mu_i(x_t))}\\mid\\mathcal H_{t-1},x_t\\right]\\le e^{s^2/2}\\qquad(s\\in\\mathbb R,\\ 1\\le i\\le m).$$ Causal randomized policies are allowed. Inputs $K,m,T,\\delta_{\\mathrm{conf}}$ and a tradeoff bound satisfying $\\lambda\\ge\\lambda_\\star$ are public. Mean vectors and the set of primary-objective optimal arms are hidden. Observed feedback may be stored and reused computationally; no unrevealed past information or additional queries to exhausted samples are available. Any within-round full-function or common-sample access must be explicit.",
        "response_signature": {
          "feedback": "all m coordinates of the selected arm reward vector",
          "noise": "each coordinate is conditionally 1-sub-Gaussian about its fixed mean given past data and current arm; cross-coordinate independence is not required",
          "queries": "one selected arm per round"
        },
        "domain_ref": "ONX_LEX_FINITE_KNOWN_dom_21ef176374",
        "feedback_quality": {
          "feedback": "all m coordinates of the selected arm reward vector",
          "noise": "each coordinate is conditionally 1-sub-Gaussian about its fixed mean given past data and current arm; cross-coordinate independence is not required",
          "queries": "one selected arm per round"
        },
        "access_schedule_ref": "ONX_LEX_FINITE_KNOWN_pro_5ae9a2111a",
        "cost_rule_ref": "ONX_LEX_FINITE_KNOWN_res_851de466a1",
        "display_label_zh": "Full objective vector of the selected arm"
      },
      "target_object_registry": [
        {
          "id": "ONX_LEX_FINITE_KNOWN_obj_e645b31fe0",
          "type": "online_environment",
          "definition": "The finite action set has $K$ arms with a discrete metric of diameter at most $1$. Each arm has $m$ fixed mean rewards $\\mu_1,\\ldots,\\mu_m$, ordered by priority, and each mean function is $1$-Lipschitz. Each objective has oscillation at most $1$; irrelevant common additive shifts are unrestricted. A lexicographically optimal arm $x^\\star$ exists. Ties are allowed: each lower-priority objective is compared among arms optimal for all higher priorities. The tradeoff coefficient must be finite: $$\\lambda_\\star=\\inf\\!\\left\\{\\lambda\\ge0:\\ \\mu_i(x)-\\mu_i(x^\\star)\\le\\lambda\\max_{j<i}\\bigl(\\mu_j(x^\\star)-\\mu_j(x)\\bigr),\\ \\forall x\\in\\mathcal X,\\ 2\\le i\\le m\\right\\}<\\infty.$$"
        }
      ],
