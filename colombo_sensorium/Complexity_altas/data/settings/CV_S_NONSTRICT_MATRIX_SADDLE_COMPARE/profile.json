      "formulation_code": "nonstrict_matrix_saddlepoint_search",
      "formulation": "A_{ij}\\ge A_{ik}\\ \\forall k,\\qquad A_{ij}\\le A_{\\ell j}\\ \\forall\\ell",
      "formulation_latex": "A_{ij}\\ge A_{ik}\\ \\forall k,\\qquad A_{ij}\\le A_{\\ell j}\\ \\forall\\ell",
      "solution_goal": "find_nonstrict_saddlepoint_or_absence",
      "protocol_ref": null,
      "description_paragraphs": [
        "Find an entry attaining its row maximum and column minimum. If no such entry exists, report absence. Ties are permitted. Return any qualifying index when there are several."
      ]
    },
