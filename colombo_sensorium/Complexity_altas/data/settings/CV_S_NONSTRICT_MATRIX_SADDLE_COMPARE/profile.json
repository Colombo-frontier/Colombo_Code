          "scope": "Whole fixed matrix",
          "description": "Entries may tie and existence is unrestricted."
        }
      ],
      "parameter_domain_description": "Public integer $n\\ge1$.",
      "description_paragraphs": [
        "Fix $A\\in\\mathbb R^{n\\times n}$. Entries may repeat. A non-strict saddlepoint may be absent or nonunique."
      ]
    },
    "oracle": {
