      "target_object_registry": [
        {
          "id": "ONX_OCO_NON_EUCLIDEAN_obj_ae923464e6",
          "type": "online_environment",
          "definition": "The compact convex set $X\\subset\\mathbb R^d$, norm $\\|\\cdot\\|$, and dual norm $\\|\\cdot\\|_*$ are public. Each loss $f_t$ is convex, and the returned valid subgradient satisfies $g_t\\in\\partial f_t(x_t)$ and $\\|g_t\\|_*\\le G_*$. The regularizer $\\psi$ is differentiable on a neighborhood of $X$ and $1$-strongly convex in the specified norm. The public initial point $x_{\\mathrm{init}}\\in X$ satisfies $$D_\\psi(u,v)=\\psi(u)-\\psi(v)-\\langle\\nabla\\psi(v),u-v\\rangle,\\qquad \\sup_{u\\in X}D_\\psi(u,x_{\\mathrm{init}})\\le R_\\psi^2.$$. The environment may fix losses in advance or select them from the history consistently with current subgradient feedback, without anticipating current private randomness."
        }
