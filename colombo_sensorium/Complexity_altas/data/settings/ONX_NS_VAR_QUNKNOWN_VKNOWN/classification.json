        "id": "ONX_NS_VAR_QUNKNOWN_VKNOWN_ora_417e09e388",
        "operation_code": "selected_reward",
        "target_object": "ONX_NS_VAR_QUNKNOWN_VKNOWN_obj_5908fbff95",
        "query_signature": "Choose arm $I_t$ and receive one reward $X_{t,I_t}$. Noise may be heteroscedastic or zero; reward laws may vary over time even with constant means. Inputs $K,T$ and mean-drift bound $V$ satisfying $V_\\mu\\le V$ are public. Armwise variances, means, change locations, and variance budget $Q$ are hidden. A causal policy cannot use undisclosed budgets and must work simultaneously across all such unknown-budget classes. Received feedback may be stored and reused computationally. No unrevealed historical information or extra queries to exhausted samples are available; any within-round full-function or common-sample access must be explicit.",
        "response_signature": {
          "feedback": "one selected reward",
          "noise": "heteroscedastic, possibly zero variance; laws need not be stationary even if means constant"
        },
        "domain_ref": "ONX_NS_VAR_QUNKNOWN_VKNOWN_dom_39759d9911",
        "feedback_quality": {
          "feedback": "one selected reward",
          "noise": "heteroscedastic, possibly zero variance; laws need not be stationary even if means constant"
        },
        "access_schedule_ref": "ONX_NS_VAR_QUNKNOWN_VKNOWN_pro_82342ce362",
        "cost_rule_ref": "ONX_NS_VAR_QUNKNOWN_VKNOWN_res_6570db2ddd",
        "display_label_zh": "Scalar reward of the selected action"
      },
      "target_object_registry": [
        {
          "id": "ONX_NS_VAR_QUNKNOWN_VKNOWN_obj_5908fbff95",
          "type": "online_environment",
          "definition": "There are $K\\ge2$ arms. The reward laws $\\nu_{t,i}$ are fixed before interaction, supported on $[0,1]$, and sampled independently across rounds. Denote means by $\\mu_{t,i}=\\mathbb E X_{t,i}$ and their vector by $\\mu_t$. $$V_\\mu=\\sum_{t=2}^{T}\\|\\mu_t-\\mu_{t-1}\\|_\\infty,\\qquad Q_{\\mathrm{env}}=\\sum_{t=1}^{T}\\max_{1\\le i\\le K}\\operatorname{Var}(X_{t,i})\\le\\frac T4.$$ The quantity $Q_{\\mathrm{env}}$ sums the largest arm variance in each round; it is neither the variance sum along the chosen arms nor the sum over all arms."
        }
      ],
