      "source_fields": {
        "id": "ONX_RISING_CONCAVE_UNKNOWNV_ora_9706705ba6",
        "operation_code": "selected_reward",
        "target_object": "ONX_RISING_CONCAVE_UNKNOWNV_obj_07b59f8aec",
        "query_signature": "Select $I_t\\in[K]$ using past observations and then observe only $X_{I_t,t}$. Rewards of other arms are not revealed. Each $X_{i,t}$ is $\\sigma$-sub-Gaussian around $\\mu_i(t)$ and independent of the entire reward table before round $t$. Dependence across arms within a round does not change this feedback model. Only reward means are restricted to $[0,1]$; realizations need not lie in that interval. Causal bandit policies are allowed. Inputs $K,T,\\sigma$ are public; neither $V$ nor any variation bound beyond structural feasibility is supplied. Mean functions and, for the concave model, change times are hidden. Past feedback may be reused computationally, without extra historical or sample queries beyond the explicit interface.",
        "response_signature": {
          "feedback": "selected reward X_{I_t,t}",
          "noise": "Each X_(i,t) has fixed mean mu_i(t), is sigma-sub-Gaussian, and is independent of the full reward-table history before t; within-time cross-arm dependence is irrelevant because one reward is selected.",
          "evolution": "all arms evolve with calendar time, including unpulled arms"
        },
        "domain_ref": "ONX_RISING_CONCAVE_UNKNOWNV_dom_c9d2828636",
        "feedback_quality": {
          "feedback": "selected reward X_{I_t,t}",
          "noise": "Each X_(i,t) has fixed mean mu_i(t), is sigma-sub-Gaussian, and is independent of the full reward-table history before t; within-time cross-arm dependence is irrelevant because one reward is selected.",
          "evolution": "all arms evolve with calendar time, including unpulled arms"
        },
        "access_schedule_ref": "ONX_RISING_CONCAVE_UNKNOWNV_pro_9db7cd285c",
        "cost_rule_ref": "ONX_RISING_CONCAVE_UNKNOWNV_res_bc3d010d34",
        "display_label_zh": "Scalar reward of the selected action"
      },
      "target_object_registry": [
        {
          "id": "ONX_RISING_CONCAVE_UNKNOWNV_obj_07b59f8aec",
          "type": "online_environment",
          "definition": "The reward laws $\\nu_i(t)$ of the $K\\ge2$ arms are fixed before interaction and evolve with absolute time, including for unpulled arms. Their means satisfy $$\\mu_i(t)=\\mathbb E_{X\\sim\\nu_i(t)}X\\in[0,1],\\qquad \\gamma_i(t)=\\mu_i(t+1)-\\mu_i(t)\\ge0.$$ and are discretely concave in time: $$\\gamma_i(t+1)\\le\\gamma_i(t).$$ $$V_\\mu=\\sum_{t=1}^{T-1}\\max_{i\\in[K]}\\gamma_i(t)\\le V,\\qquad 0\\le V\\le K.$$"
        }
      ],
