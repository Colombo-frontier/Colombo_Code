      "source_fields": {
        "id": "ONX_PARAMNOISE_LP_UNKNOWNCOV_ora_43c66b5849",
        "operation_code": "selected_reward",
        "target_object": "ONX_PARAMNOISE_LP_UNKNOWNCOV_obj_a1ab06c2a4",
        "query_signature": "$$Y_t=\\langle a_t,\\theta_t\\rangle,\\qquad \\operatorname{Var}(Y_t\\mid a_t)=a_t^{\\mathsf T}\\Sigma a_t.$$ Choose $a_t$ first, then draw a fresh $\\theta_t$ and reveal only the scalar projection. The same $\\theta_t$ defines all counterfactual rewards that round, but other projections are hidden. Causal policies are allowed. Inputs $d,p,q,T,\\delta_{\\mathrm{conf}}$ are public; the distribution $\\nu$, mean $\\theta_*$, and covariance $\\Sigma$ are hidden. Received feedback may be stored and reused computationally; no unrevealed historical information or extra queries to exhausted samples are available. Within-round exceptions require explicit full-function or common-sample access.",
        "response_signature": {
          "feedback": "one scalar projection of a fresh random parameter vector",
          "coupling": "same theta_t would define all counterfactual actions, but only chosen scalar is observed"
        },
        "domain_ref": "ONX_PARAMNOISE_LP_UNKNOWNCOV_dom_f5a823c823",
        "feedback_quality": {
          "feedback": "one scalar projection of a fresh random parameter vector",
          "coupling": "same theta_t would define all counterfactual actions, but only chosen scalar is observed"
        },
        "access_schedule_ref": "ONX_PARAMNOISE_LP_UNKNOWNCOV_pro_1f88454785",
        "cost_rule_ref": "ONX_PARAMNOISE_LP_UNKNOWNCOV_res_90727fbecf",
        "display_label_zh": "Scalar reward of the selected action"
      },
      "target_object_registry": [
        {
          "id": "ONX_PARAMNOISE_LP_UNKNOWNCOV_obj_a1ab06c2a4",
          "type": "online_environment",
          "definition": "$$\\mathcal A=\\{a\\in\\mathbb R^d:\\|a\\|_p\\le1\\},\\qquad 1<p\\le2,\\qquad q=\\frac{p}{p-1}.$$ $$\\theta_t\\overset{\\mathrm{i.i.d.}}\\sim\\nu,\\qquad \\mathbb E\\theta_t=\\theta_*,\\qquad \\operatorname{Cov}(\\theta_t)=\\Sigma,\\qquad |\\langle a,\\theta_t\\rangle|\\le1\\quad\\text{almost surely, for every }a\\in\\mathcal A.$$ Randomness comes from a fresh parameter vector each round; the feedback is not a linear regression observation with additive homoscedastic scalar noise. $$N=T,\\qquad \\sigma_q^2=\\left(\\sum_{i=1}^{d}\\Sigma_{ii}^{q/2}\\right)^{2/q}.$$ Here $N$ counts scalar observations. The quantity $\\sigma_q^2$ is defined by the covariance diagonal and cannot be replaced by the maximum action variance."
        }
      ],
