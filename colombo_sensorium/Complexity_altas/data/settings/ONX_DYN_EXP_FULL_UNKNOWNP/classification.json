      "source_fields": {
        "id": "ONX_DYN_EXP_FULL_UNKNOWNP_ora_26d11fd8b6",
        "operation_code": "full_current_function",
        "target_object": "ONX_DYN_EXP_FULL_UNKNOWNP_obj_57b5b6b133",
        "query_signature": "Submit $w_t\\in W$, incur $f_t(w_t)$, and then receive the full function $f_t$. Its values and gradients may subsequently be evaluated at other points, without observation noise. The public projection interface provides exact Mahalanobis projections for any positive definite metric $A\\succ0$; each such projection has arithmetic cost $C_{\\mathrm{proj}}(d)$. $$\\Pi_W^A(z)\\in\\operatorname*{arg\\,min}_{w\\in W}(w-z)^{\\mathsf T}A(w-z).$$ Inputs $d,T,D,G,\\eta$, the set $W$, and its projection interface are public. Neither the comparator path $u_{1:T}$ nor its total path length $P_T^{(2)}$ is supplied. Past feedback may be stored and reused computationally; no unrevealed historical information or extra queries to exhausted samples are available beyond the explicitly declared within-round interface.",
        "response_signature": {
          "feedback": "full revealed f_t with loss/gradient evaluations at extra points",
          "noise": "None.",
          "projection": "exact Mahalanobis projection for every positive-definite metric A at cost C_proj(d)"
        },
        "domain_ref": "ONX_DYN_EXP_FULL_UNKNOWNP_dom_af1b4299c8",
        "feedback_quality": {
          "feedback": "full revealed f_t with loss/gradient evaluations at extra points",
          "noise": "None.",
          "projection": "exact Mahalanobis projection for every positive-definite metric A at cost C_proj(d)"
        },
        "access_schedule_ref": "ONX_DYN_EXP_FULL_UNKNOWNP_pro_b380b0b091",
        "cost_rule_ref": "ONX_DYN_EXP_FULL_UNKNOWNP_res_c72ca766d1",
        "display_label_zh": "Access to the complete current function"
      },
      "target_object_registry": [
        {
          "id": "ONX_DYN_EXP_FULL_UNKNOWNP_obj_57b5b6b133",
          "type": "online_environment",
          "definition": "The learner acts in the same nonempty compact convex set $W\\subset\\mathbb R^d$ each round and is compared simultaneously with every comparator path $u_{1:T}\\in W^T$. Losses are differentiable and exp-concave on $W$: $$\\operatorname{diam}_2(W)\\le D,\\qquad e^{-\\eta f_t(\\cdot)}\\ \\text{on }W\\text{ is concave},\\qquad \\|\\nabla f_t(w)\\|_2\\le G\\quad(\\forall t,\\ w\\in W).$$ The upper bound holds for every admissible realized loss sequence; the recorded lower bound uses an oblivious sequence. For dimension optimality, $D,G,\\eta$ are fixed independently of $d,T$."
        }
      ],
