        "id": "ONX_MULTI_UNITBALL_ora_b3d9324b3a",
        "operation_code": "batched_task_rewards",
        "target_object": "ONX_MULTI_UNITBALL_obj_c0deaba52d",
        "query_signature": "Submit all $M$ actions simultaneously and receive all rewards together, with no within-batch sequential feedback. $$Y_{t,m}=\\langle x_{t,m},\\theta_m\\rangle+\\eta_{t,m}.$$ The variables $\\eta_{t,m}$ are i.i.d. $\\mathcal N(0,1)$ across tasks and rounds. Centralized causal policies are allowed. Inputs $d,r,M,T$ are public; the shared basis $B$ and coefficient matrix $W=[w_1,\\ldots,w_M]$ are hidden. Received feedback may be stored and reused computationally. No unrevealed historical information or extra queries to exhausted samples are available; any within-round full-function or common-sample access must be explicit.",
        "response_signature": {
          "feedback": "M scalar linear rewards per batch",
          "noise": "iid N(0,1) across task and round"
        },
        "domain_ref": "ONX_MULTI_UNITBALL_dom_5f65218d57",
        "feedback_quality": {
