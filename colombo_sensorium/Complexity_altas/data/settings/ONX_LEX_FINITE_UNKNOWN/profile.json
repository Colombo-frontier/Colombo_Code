          "scope": "The domain stated in this clause."
        },
        {
          "id": "ONX_LEX_FINITE_UNKNOWN__colombo_assumption_20793045e7ec",
          "property_code": "explicit_model_clause",
          "subject_id": "ONX_LEX_FINITE_UNKNOWN__instance",
          "description": "There are two fixed reward means $\\mu^1,\\mu^2$ taking values in $[0,1]$. The primary optimum set is $\\mathcal X_1^*=\\arg\\max_x\\mu^1(x)$, and a lexicographic optimum $x^*$ maximizes $\\mu^2$ over that set. Primary ties are permitted.",
          "scope": "The domain stated in this clause."
        },
        {
          "id": "ONX_LEX_FINITE_UNKNOWN__colombo_assumption_d6689dddb64e",
          "property_code": "explicit_model_clause",
          "subject_id": "ONX_LEX_FINITE_UNKNOWN__instance",
          "description": "The local tradeoff is $\\lambda_* =\\inf\\{\\lambda\\ge0:\\mu^2(x)-\\mu^2(x^*)\\le\\lambda[\\mu^1(x^*)-\\mu^1(x)]\\ \\forall x\\}$. No value or upper bound for $\\lambda_*$ is supplied. The same policy must handle all admissible means without such side information.",
          "scope": "The domain stated in this clause."
        }
