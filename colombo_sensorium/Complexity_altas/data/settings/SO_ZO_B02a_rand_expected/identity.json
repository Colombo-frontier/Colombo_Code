          ]
        },
        "metric": {
          "native_metric_wording": "$\\ell(I,x)=\\min_{g\\in\\partial_\\rho f(x)}\\gamma^{-1}\\|x-\\operatorname{prox}_{\\gamma\\psi}(x-\\gamma g)\\|_2$, where $\\gamma>0$ is a fixed known step size. The target tolerance is $\\varepsilon$.",
          "formula_latex": "\\min_{g\\in\\partial_\\rho f(\\widehat{x})}\\gamma^{-1}\\|\\widehat{x}-\\operatorname{prox}_{\\gamma\\psi}(\\widehat{x}-\\gamma g)\\|_2",
