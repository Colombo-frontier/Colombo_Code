          "base_expression": "\\min_{g\\in\\partial_\\rho f(\\widehat{x})}\\gamma^{-1}\\|\\widehat{x}-\\operatorname{prox}_{\\gamma\\psi}(\\widehat{x}-\\gamma g)\\|_2"
