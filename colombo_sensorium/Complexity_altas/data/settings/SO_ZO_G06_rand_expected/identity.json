        "task": {
          "solution_goal": "global_minimization",
          "code": "single_objective_optimization",
          "description_paragraphs": [
            "Find an approximate global minimizer of the unknown objective over $\\mathbb{S}^d$. Evaluate the final recommendation by simple regret $f(\\widehat{x})-\\min_{u\\in \\mathbb{S}^d}f(u)$; losses incurred during queries are not accumulated."
          ],
          "navigation_domains": [
            "single_objective"
