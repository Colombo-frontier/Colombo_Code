          ],
          "domain": "$\\mathbb{S}^d$",
          "variant": null,
          "code": "independent_noisy_value",
          "description_paragraphs": [
            "A query at $x_t\\in \\mathbb{S}^d$ returns one scalar $Y_t=f(x_t)+\\xi_t$.",
            "Noise is independent, centered and sub-Gaussian: $\\mathbb{E} e^{\\lambda\\xi_t}\\le e^{\\lambda^2 \\sigma_v^2/2}$ for every $\\lambda\\in\\mathbb{R}$. It is independent of the algorithmic seed and preceding observations. The noise class includes Gaussian noise at the same scale.",
            "Every observation is charged independently. No same-sample coupling, sample handle, or noiseless function value is supplied.",
            "The public inputs are $d$, $B$, $k$, $\\sigma_v$, $\\varepsilon$, $T$, together with the sets, kernels and auxiliary operations explicitly declared above. Information about the unknown objective and any undisclosed sample distribution is obtained only through the stated interface."
          ]
        },
        "output": {
          "domain": "$\\mathbb{S}^d$",
          "code": "output_space",
          "description_paragraphs": [
