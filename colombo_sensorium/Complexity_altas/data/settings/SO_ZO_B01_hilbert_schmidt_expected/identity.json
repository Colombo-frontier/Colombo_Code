          "description_paragraphs": [
            "Minimize $f$ globally over $\\mathbb{R}^d$ and return a point with small objective gap."
          ],
          "navigation_domains": [
            "single_objective"
          ],
          "formulation_code": "SO.global_minimization"
        },
        "model": {
