      "source_fields": {
        "navigation_domains": [
          "single_objective"
        ],
        "formulation": "Given a public compact product domain $D$ and initial point $x_1\\in D$, minimize a hidden convex function over $D$. The complexity is uniform over the permitted public geometries, with the algorithm selected after the geometry is known.",
        "solution_goal": "objective_minimization"
      },
      "narrative_pointers": [
        "/common_specification/task/description_paragraphs"
      ],
      "equivalence_review": "unreviewed",
