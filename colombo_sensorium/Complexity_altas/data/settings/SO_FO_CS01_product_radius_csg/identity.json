    "instance_model": {
      "state": "source_structured",
      "source_pointer": "/common_specification/model",
      "source_fields": {
        "assumptions": [
          {
            "id": "SO_FO_CS01_product_radius_csg__colombo_assumption_118a0c77d7dc",
            "property_code": "explicit_model_clause",
            "subject_id": "SO_FO_CS01_product_radius_csg__instance",
            "description": "The public domain is $$D=\\prod_{i=1}^d[\\ell_i,u_i],\\qquad-\\infty<\\ell_i\\le u_i<\\infty.$$ Singleton factors are allowed. There is no bound on $\\operatorname{diam}(D)/R_B$.",
            "scope": "The domain stated in this clause."
          },
          {
            "id": "SO_FO_CS01_product_radius_csg__colombo_assumption_40200dbe0956",
            "property_code": "explicit_model_clause",
            "subject_id": "SO_FO_CS01_product_radius_csg__instance",
            "description": "An instance is a finite convex Euclidean $G$-Lipschitz function $f:D\\to\\mathbb R$ and one fixed Borel map $g:D\\to\\mathbb R^d$ such that $$f(z)\\ge f(x)+\\langle g(x),z-x\\rangle,\\quad\\|g(x)\\|_2\\le G\\qquad(x,z\\in D).$$ At boundary points this supporting inequality is relative to $D$.",
            "scope": "The domain stated in this clause."
          },
          {
            "id": "SO_FO_CS01_product_radius_csg__colombo_assumption_284b930206a6",
            "property_code": "explicit_model_clause",
            "subject_id": "SO_FO_CS01_product_radius_csg__instance",
            "description": "At least one constrained minimizer satisfies $\\frac12\\|x^\\star-x_1\\|_2^2\\le R_B^2$. The radius $R_B$ is independent of the size of the product domain. The pair $(f,g)$ is fixed before the private seed is sampled.",
            "scope": "The domain stated in this clause."
          }
        ],
        "properties": {
          "convexity": "convex",
          "smoothness": [
            "lipschitz"
          ]
        }
      },
