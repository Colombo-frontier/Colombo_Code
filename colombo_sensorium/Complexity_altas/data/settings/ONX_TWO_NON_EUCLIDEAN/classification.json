      "source_fields": {
        "id": "ONX_TWO_NON_EUCLIDEAN_ora_5a3f84b5c2",
        "operation_code": "two_point_exact",
        "target_object": "ONX_TWO_NON_EUCLIDEAN_obj_940a0957d3",
        "query_signature": "$$f_t(x_t+\\rho_tu_t),\\qquad f_t(x_t-\\rho_tu_t).$$ Both evaluations use the same current function without measurement noise, and are revealed after the probes are submitted. The center satisfies $x_t\\in W$; probes may lie outside $W$ because losses are defined on the whole space. Loss is incurred only at the center $x_t$. Causal learners keep centers feasible. Inputs $W,\\psi,\\|\\cdot\\|,G_2,R_\\psi,p_*,T$ are public, and one mirror/proximal update is allowed per round. Received feedback may be stored and reused computationally. No unrevealed historical information or extra queries to exhausted samples are available; any within-round full-function or common-sample access must be explicit.",
        "response_signature": {
          "feedback": "exact f_t(x_t+rho_t u_t), f_t(x_t-rho_t u_t)",
          "coupling": "same current function, no measurement noise",
          "queries_domain": "globally defined loss; probes may lie outside W",
          "loss_bearing": "only center x_t"
        },
        "domain_ref": "ONX_TWO_NON_EUCLIDEAN_dom_4d0dca5fe8",
        "feedback_quality": {
          "feedback": "exact f_t(x_t+rho_t u_t), f_t(x_t-rho_t u_t)",
          "coupling": "same current function, no measurement noise",
          "queries_domain": "globally defined loss; probes may lie outside W",
          "loss_bearing": "only center x_t"
        },
        "access_schedule_ref": "ONX_TWO_NON_EUCLIDEAN_pro_9f85ee3a23",
        "cost_rule_ref": "ONX_TWO_NON_EUCLIDEAN_res_be8ac3cf04",
        "display_label_zh": "Exact values at two points of the same function."
      },
      "target_object_registry": [
        {
          "id": "ONX_TWO_NON_EUCLIDEAN_obj_940a0957d3",
          "type": "online_environment",
          "definition": "The compact convex center-action set $W\\subset\\mathbb R^d$, norm $\\|\\cdot\\|$, and its dual are public. The regularizer $\\psi$ is $1$-strongly convex in that norm and satisfies $$0\\le\\psi(x)\\le R_\\psi^2\\quad(x\\in W),\\qquad p_*\\ge\\left(\\mathbb E_{u\\sim\\operatorname{Unif}(\\mathbb S^{d-1})}\\|u\\|_*^4\\right)^{1/4}.$$. All losses are fixed before interaction, convex on all of $\\mathbb R^d$, and $G_2$-Lipschitz in the Euclidean norm."
        }
      ],
