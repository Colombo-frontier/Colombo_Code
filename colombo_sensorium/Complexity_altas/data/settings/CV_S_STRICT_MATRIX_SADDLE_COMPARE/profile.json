          "target_object": "CV_S_STRICT_MATRIX_SADDLE_COMPARE__obj_A",
          "variable_blocks": [],
          "query_signature": "$((i,j),(\\ell,k))\\in([m]\\times[n])^2$",
          "response_signature": "$\\mathbf{1}\\{A_{ij}<A_{\\ell k}\\}$",
