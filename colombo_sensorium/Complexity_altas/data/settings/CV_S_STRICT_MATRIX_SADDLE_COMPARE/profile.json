      "navigation_domains": [
        "matrix_computation"
      ],
      "formulation_code": "strict_matrix_saddlepoint_search",
      "formulation": "A_{ij}>A_{ik}\\ \\forall k\\ne j,\\qquad A_{ij}<A_{\\ell j}\\ \\forall\\ell\\ne i",
      "formulation_latex": "A_{ij}>A_{ik}\\ \\forall k\\ne j,\\qquad A_{ij}<A_{\\ell j}\\ \\forall\\ell\\ne i",
      "solution_goal": "find_strict_saddlepoint_or_absence",
      "protocol_ref": null,
      "description_paragraphs": [
        "Identify the unique matrix entry that is strictly largest in its row and strictly smallest in its column. If no such entry exists, report absence."
      ]
    },
    "model": {
      "instance": "An arbitrary fixed hidden matrix $A\\in\\mathbb R^{m\\times n}$ with public positive integer dimensions.",
      "assumptions": [
