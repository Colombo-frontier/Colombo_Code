            "CV_S_STRICT_MATRIX_SADDLE_COMPARE__p_n"
          ],
          "scope": "Whole fixed matrix",
          "description": "Entries may tie and existence is unrestricted."
        }
      ],
      "parameter_domain_description": "Public integers $m,n\\ge1$. All real matrices of the stated shape are admissible.",
      "description_paragraphs": [
        "Fix $A\\in\\mathbb R^{m\\times n}$. Entries may repeat. A strict saddlepoint, when it exists, is unique."
      ]
    },
    "oracle": {
