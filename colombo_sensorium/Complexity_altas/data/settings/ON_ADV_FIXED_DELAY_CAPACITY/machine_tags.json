    "norms": [
      {
        "id": "ON_ADV_FIXED_DELAY_CAPACITY_nor_60596e4d87",
        "definition": "The model specifies coordinate ranges of finite vectors. Discrete action labels have no derivative order. A placeholder norm imposes no additional geometric assumption."
      }
    ],
    "protocols": [
      {
        "id": "ON_ADV_FIXED_DELAY_CAPACITY_pro_1ad04c9362",
        "steps": [
          "Before play, an oblivious adversary fixes $(\\ell_1,\\ldots,\\ell_T)$, with $\\ell_t\\in[0,1]^K$. The common delay $d$ is public.",
          "At round $t$, choose and incur the loss of one arm $a_t\\in[K]$, and decide whether to start tracking that round. These choices use earlier delivered feedback and private randomness.",
          "At the end of round $t$, return $(s,\\ell_s(a_s))$ for each still-tracked $s$ with $s+d=t$; release delivered slots. A round never tracked gives no feedback. No preemption is needed for the upper bound; this profile uses non-preemptive tracking.",
          "At most $C$ rounds can be tracked at once, including a newly tracked round before that round's deliveries."
        ],
        "adversary_information": "The environment fixes the complete loss sequence before interaction. It may know the algorithm and public parameters but cannot depend on the learner's private seed. This is an oblivious environment; nonanticipation describes the learner's causal information and does not extend the specification to a history-adaptive adversary.",
        "loss_bearing_points": "Exactly one arm each round, even when its round is not tracked.",
        "queries_per_round": "One loss-incurring action and one optional tracking registration per round; at most one delivered loss per round for fixed delay.",
        "past_requery": "None. Delivered feedback can be processed; untracked past losses cannot be recovered."
      }
    ],
    "comparators": [
      {
        "id": "ON_ADV_FIXED_DELAY_CAPACITY_com_1365e7e04e",
        "definition": "Best fixed arm in hindsight."
      }
    ]
  },
