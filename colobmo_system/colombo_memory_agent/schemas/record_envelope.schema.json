{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Colombo scientific record envelope, semantic validation in contracts.py",
  "type": "object",
  "required": [
    "schema",
    "id",
    "revision",
    "kind",
    "title",
    "aliases",
    "summary",
    "use_when",
    "content",
    "navigation",
    "source_refs",
    "links",
    "evidence"
  ],
  "properties": {
    "schema": {
      "const": "colombo-scientific-memory/2"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "revision": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "kind": {
      "enum": [
        "algorithm",
        "hard_family",
        "theorem",
        "proof_method",
        "source"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "use_when": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content": {
      "type": "object"
    },
    "navigation": {
      "type": "object"
    },
    "source_refs": {
      "type": "array"
    },
    "links": {
      "type": "array"
    },
    "evidence": {
      "type": "object"
    }
  },
  "additionalProperties": false
}