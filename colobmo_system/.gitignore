/.long_term_memory.layout.lock/
/.long_term_memory.layout-build-*/

# Clean publication: generated output and local credentials.
/downstream_runs/
/validation/
/.env
/.env.*
/.codex/
/.claude/
auth.json
credentials.json
*.pem
*.key

# Private curation execution and workstation provenance are not public payloads.
.DS_Store
/.long_term_memory_state/staging/
/.long_term_memory_state/archive/
/.long_term_memory_state/LAYOUT_MIGRATION.json
/.long_term_memory_state/evidence/**/jobs/
/.long_term_memory_state/evidence/**/artifacts/

# Never distribute workstation secrets or generated local state.
.env*
**/.env*
*.pyo
*.log
*.sqlite-wal
*.sqlite-shm
node_modules/
.pytest_cache/
.mypy_cache/
.ruff_cache/
