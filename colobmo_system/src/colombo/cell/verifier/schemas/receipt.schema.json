{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cell review submission receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "verdict",
    "report_revision"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "pattern": "^r[0-9]{4,}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "revise",
        "inconclusive"
      ]
    },
    "report_revision": {
      "type": "integer",
      "minimum": 1
    }
  }
}
