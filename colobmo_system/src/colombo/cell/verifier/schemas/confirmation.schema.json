{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent review of an exact mathematical audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "assessment",
    "covered_check_ids",
    "findings",
    "decisive_steps",
    "new_findings",
    "review_id",
    "report_revision"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "confirmed",
        "needs_correction"
      ]
    },
    "summary": {
      "type": "string",
      "pattern": "\\S"
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_alignment",
        "coverage",
        "reasoning",
        "sources",
        "record_mapping"
      ],
      "properties": {
        "target_alignment": {
          "$ref": "#/$defs/assessment"
        },
        "coverage": {
          "$ref": "#/$defs/assessment"
        },
        "reasoning": {
          "$ref": "#/$defs/assessment"
        },
        "sources": {
          "$ref": "#/$defs/assessment"
        },
        "record_mapping": {
          "$ref": "#/$defs/assessment"
        }
      }
    },
    "covered_check_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "status",
          "reason"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "supported",
              "disputed",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "decisive_steps": {
      "type": "array",
      "description": "Independent checks of decisive steps. Status evaluates support for the first report's judgment about each step, not whether the original proof step is valid. Independently demonstrating a reported erroneous inference supports a revise judgment and uses supported.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location",
          "status",
          "reason"
        ],
        "properties": {
          "location": {
            "type": "string",
            "pattern": "\\S"
          },
          "status": {
            "enum": [
              "supported",
              "disputed",
              "unresolved"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "new_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location",
          "explanation",
          "repair"
        ],
        "properties": {
          "location": {
            "type": "string",
            "pattern": "\\S"
          },
          "explanation": {
            "type": "string",
            "pattern": "\\S"
          },
          "repair": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "review_id": {
      "type": "string",
      "pattern": "^r[0-9]{4,}$"
    },
    "report_revision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "supported",
            "disputed",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  }
}
