{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cell mathematical review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "summary",
    "target_alignment",
    "checks",
    "findings",
    "sources",
    "coverage"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "revise",
        "inconclusive"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "target_alignment": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "coverage": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "reason",
        "subject",
        "location"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "pass",
            "fail",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "check_id",
        "kind",
        "location",
        "explanation",
        "repair"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "check_id": {
          "type": "integer",
          "minimum": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "error",
            "gap",
            "uncertain",
            "note"
          ]
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "repair": {
          "type": "string"
        },
        "scope": {
          "enum": [
            "record",
            "application",
            "draft"
          ]
        },
        "affected_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_ref"
          }
        }
      }
    },
    "record_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "revision"
      ],
      "properties": {
        "position": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "property_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "citation",
        "location",
        "status",
        "evidence",
        "application",
        "check_id"
      ],
      "properties": {
        "citation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "location": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "type": "string",
          "enum": [
            "confirmed",
            "mismatch",
            "unavailable"
          ]
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "application": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "check_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
